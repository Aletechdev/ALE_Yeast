{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/bin/check_credential_expiry.sh",
            "timeout": 10,
            "statusMessage": "Checking credential expiry dates"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/bin/hook_git_commit_gate.sh",
            "timeout": 15,
            "statusMessage": "Checking that output-affecting changes cite their validation"
          }
        ]
      }
    ]
  }
}
