<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <link href="https://unpkg.com/tabulator-tables@6.3.0/dist/css/tabulator.min.css" rel="stylesheet">
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
            color: #333;
        }
        h1 { border-bottom: 2px solid #0366d6; padding-bottom: 8px; }
        h2 { margin-top: 32px; color: #24292e; }
        a { color: #0366d6; text-decoration: none; }
        a:hover { text-decoration: underline; }
        .report-link {
            display: inline-block;
            padding: 8px 16px;
            margin: 4px 8px 4px 0;
            border-radius: 4px;
            background: #f6f8fa;
            border: 1px solid #e1e4e8;
        }
        .report-link:hover { background: #e1e4e8; text-decoration: none; }
        .meta { color: #586069; font-size: 0.9em; }
        .note { color: #586069; font-size: 0.9em; margin-top: 4px; }
        .section { margin: 24px 0; }
        .footer {
            color: #586069;
            font-size: 0.85em;
            margin-top: 40px;
            border-top: 1px solid #e1e4e8;
            padding-top: 12px;
        }
        /* Tabulator overrides for consistent styling */
        .tabulator { font-size: 0.9em; border: 1px solid #e1e4e8; }
        .tabulator .tabulator-header { background: #f6f8fa; }
        .tabulator-row.tabulator-row-even { background: #fafbfc; }
        .igv-link { cursor: pointer; color: #0366d6; text-decoration: underline; }
        .badge {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 0.8em;
            font-weight: 600;
        }
        .badge-high { background: #ffeef0; color: #cb2431; }
        .badge-mod { background: #fff5b1; color: #735c0f; }
        .badge-low { background: #e6ffed; color: #22863a; }
    </style>
</head>
<body>

    {# ================================================================== #}
    {# Section 1: Header                                                   #}
    {# ================================================================== #}
    <h1>{{ title }}</h1>
    <p class="meta">
        Generated {{ generated_at }} &middot;
        {{ n_samples }} samples &middot;
        {{ callers | length }} variant callers
        ({{ callers | join(', ') }})
    </p>
    <p>Variants called using
        <a href="https://gatk.broadinstitute.org/hc/en-us/articles/5358864757787-HaplotypeCaller">GATK HaplotypeCaller</a> (SNVs/indels),
        <a href="https://github.com/etal/cnvkit">CNVKit</a> (copy number),
        <a href="https://github.com/SciLifeLab/TIDDIT">TIDDIT</a> (structural variants), and
        <a href="https://github.com/Illumina/manta">Manta</a> (structural variants).
        Annotated with <a href="https://pcingola.github.io/SnpEff/">SnpEff</a>.
        Summary data from <a href="https://multiqc.info/">MultiQC</a>.
    </p>

    {# ================================================================== #}
    {# Section 2: Navigation links                                         #}
    {# ================================================================== #}
    <div class="section">
        <h2>Reports</h2>
        {% if cohort_link %}
        <a class="report-link" href="{{ cohort_link }}">
            HaplotypeCaller Cohort Report
        </a>
        {% endif %}
        <a class="report-link" href="../../output_all/multiqc/multiqc_report.html">
            MultiQC Report
        </a>
        <p class="note">
            Cohort report includes all variants across all samples with interactive
            Tabulator.js table, SnpEff annotations, and IGV browser.
            Click sample cells in the cohort report to drill down to per-sample
            reports with CRAM read pileups.
        </p>
    </div>

    {# ================================================================== #}
    {# Section 3: QC Overview (Tabulator.js)                               #}
    {# ================================================================== #}
    <div class="section">
        <h2>Sample QC Overview</h2>
        <p class="note">Sequencing quality metrics per sample. Data from MultiQC (Picard MarkDuplicates, Samtools, Mosdepth).</p>
        <div id="qc-table"></div>
    </div>

    {# ================================================================== #}
    {# Section 4: Per-Sample Variant Summary (Tabulator.js)                #}
    {# ================================================================== #}
    <div class="section">
        <h2>Per-Sample Variant Summary</h2>
        <p class="note">
            Variant counts from bcftools stats (MultiQC). HaplotypeCaller counts are from
            individual-from-joint-calling VCFs. Impact counts from SnpEff annotation.
            Click sample names to open per-sample igv-reports (where available).
        </p>
        <div id="summary-table"></div>
    </div>

    {# ================================================================== #}
    {# Footer                                                              #}
    {# ================================================================== #}
    <div class="footer">
        Generated from MultiQC summary data (bcftools stats, SnpEff, Mosdepth, Picard).<br>
        Per-sample igv-reports include GFF3 gene track + CRAM read pileups + FORMAT/VAF.<br>
        Reference: draft_ref52.fasta
    </div>

    {# ================================================================== #}
    {# JavaScript                                                          #}
    {# ================================================================== #}
    <script src="https://unpkg.com/tabulator-tables@6.3.0/dist/js/tabulator.min.js"></script>
    <script>
        // --- Data injected from Python/Jinja2 ---
        const qcData = {{ qc_data_json }};
        const summaryData = {{ summary_data_json }};

        // --- QC Overview Table ---
        new Tabulator("#qc-table", {
            data: qcData,
            layout: "fitDataFill",
            headerSortTristate: true,
            initialSort: [{ column: "sample", dir: "asc" }],
            columns: [
                { title: "Sample", field: "sample", headerFilter: "input", frozen: true, minWidth: 140 },
                { title: "Type", field: "type", headerFilter: "list", headerFilterParams: { valuesLookup: true },
                  formatter: function(cell) {
                      var v = cell.getValue();
                      return v === "Ancestral"
                          ? '<span style="color:#6f42c1;font-weight:600">' + v + '</span>'
                          : v;
                  }
                },
                { title: "Lineage", field: "lineage", headerFilter: "input" },
                { title: "Median Cov", field: "median_coverage", hozAlign: "right",
                  headerFilter: "number", headerFilterPlaceholder: "min", headerFilterFunc: ">=" },
                { title: "Dup %", field: "dup_pct", hozAlign: "right",
                  formatter: function(cell) { var v = cell.getValue(); return v != null ? v.toFixed(1) + "%" : ""; } },
                { title: "Mapped %", field: "mapped_pct", hozAlign: "right",
                  formatter: function(cell) { var v = cell.getValue(); return v != null ? v.toFixed(1) + "%" : ""; } },
                { title: "Reads (M)", field: "total_reads_m", hozAlign: "right",
                  formatter: function(cell) { var v = cell.getValue(); return v != null ? v.toFixed(1) : ""; } },
            ],
        });

        // --- Per-Sample Variant Summary Table ---
        new Tabulator("#summary-table", {
            data: summaryData,
            layout: "fitDataFill",
            headerSortTristate: true,
            initialSort: [{ column: "sample", dir: "asc" }],
            columns: [
                { title: "Sample", field: "sample", headerFilter: "input", frozen: true, minWidth: 140,
                  formatter: function(cell) {
                      var row = cell.getRow().getData();
                      if (row.igv_link) {
                          return '<a class="igv-link" href="' + row.igv_link + '">' + cell.getValue() + '</a>';
                      }
                      return cell.getValue();
                  },
                  formatterParams: { urlPrefix: "" }
                },
                { title: "Type", field: "type", headerFilter: "list", headerFilterParams: { valuesLookup: true } },
                { title: "Lineage", field: "lineage", headerFilter: "input" },
                {
                    title: "SNV / Indel",
                    columns: [
                        { title: "HC", field: "hc_variants", hozAlign: "right", sorter: "number",
                          headerFilter: "number", headerFilterPlaceholder: "min", headerFilterFunc: ">=" },
                    ]
                },
                {
                    title: "SV / CNV",
                    columns: [
                        { title: "CNVKit", field: "cnvkit_events", hozAlign: "right", sorter: "number" },
                        { title: "TIDDIT", field: "tiddit_svs", hozAlign: "right", sorter: "number" },
                        { title: "Manta", field: "manta_svs", hozAlign: "right", sorter: "number" },
                    ]
                },
                {
                    title: "HC Impact (SnpEff)",
                    columns: [
                        { title: "HIGH", field: "hc_high", hozAlign: "right", sorter: "number",
                          formatter: function(cell) {
                              var v = cell.getValue();
                              return v > 0 ? '<span class="badge badge-high">' + v + '</span>' : '0';
                          }
                        },
                        { title: "MOD", field: "hc_moderate", hozAlign: "right", sorter: "number",
                          formatter: function(cell) {
                              var v = cell.getValue();
                              return v > 0 ? '<span class="badge badge-mod">' + v + '</span>' : '0';
                          }
                        },
                        { title: "LOW", field: "hc_low", hozAlign: "right", sorter: "number",
                          formatter: function(cell) {
                              var v = cell.getValue();
                              return v > 0 ? '<span class="badge badge-low">' + v + '</span>' : '0';
                          }
                        },
                    ]
                },
                { title: "IGV Report", field: "igv_link", visible: false },
            ],
        });
    </script>
</body>
</html>
