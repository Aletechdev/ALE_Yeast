<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="color-scheme" content="light">
    <title>{{ title }}</title>
    {# Tabulator 6.3.0 is inlined from templates/vendor/ so the page works without a network; CDN only as fallback #}
    {% if tabulator_css %}
    <style>/* Tabulator v6.3.0 (c) Oliver Folkerd 2024, MIT licence */
{{ tabulator_css }}</style>
    {% else %}
    <link href="https://unpkg.com/tabulator-tables@6.3.0/dist/css/tabulator.min.css" rel="stylesheet">
    {% endif %}
    <style>
        /* --- Light theme (default) --- */
        :root {
            color-scheme: light;
            --bg: #ffffff;
            --fg: #333333;
            --fg-heading: #24292e;
            --fg-muted: #586069;
            --link: #0366d6;
            --border: #e1e4e8;
            --surface: #f6f8fa;
            --surface-alt: #fafbfc;
            --hover: #f0f1f3;
            --badge-pass-bg: #dcffe4; --badge-pass-fg: #22863a;
            --badge-warn-bg: #fff5b1; --badge-warn-fg: #735c0f;
            --badge-fail-bg: #ffeef0; --badge-fail-fg: #cb2431;
            --badge-na-bg: #f1f1f1;   --badge-na-fg: #888888;
            --code-bg: #f6f8fa;
            --table-header-bg: #f6f8fa;
            --table-border: #e1e4e8;
            --caller-manta: #22863a; --caller-manta-bg: #dcffe4;
            --caller-tiddit: #0366d6; --caller-tiddit-bg: #dbedff;
            --caller-both: #6f42c1; --caller-both-bg: #f5f0ff;
        }

        /* --- Dark theme --- */
        [data-theme="dark"] {
            color-scheme: dark;
            --bg: #0d1117;
            --fg: #c9d1d9;
            --fg-heading: #e6edf3;
            --fg-muted: #8b949e;
            --link: #58a6ff;
            --border: #30363d;
            --surface: #161b22;
            --surface-alt: #1c2128;
            --hover: #2d333b;
            --badge-pass-bg: #1b3a2a; --badge-pass-fg: #56d364;
            --badge-warn-bg: #3b2e00; --badge-warn-fg: #e3b341;
            --badge-fail-bg: #3d1418; --badge-fail-fg: #f85149;
            --badge-na-bg: #21262d;   --badge-na-fg: #8b949e;
            --code-bg: #161b22;
            --table-header-bg: #1c2128;
            --table-border: #30363d;
            --caller-manta: #56d364; --caller-manta-bg: #1b3a2a;
            --caller-tiddit: #58a6ff; --caller-tiddit-bg: #0d2240;
            --caller-both: #a371f7; --caller-both-bg: #1a0f2e;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
            max-width: 1400px;
            margin: 40px auto;
            padding: 0 20px;
            background: var(--bg);
            color: var(--fg);
        }
        h1 { border-bottom: 2px solid var(--link); padding-bottom: 8px; color: var(--fg-heading); }
        h2 { margin-top: 32px; color: var(--fg-heading); }
        a { color: var(--link); text-decoration: none; }
        a:hover { text-decoration: underline; }

        /* Report link boxes with counts */
        .report-links { display: flex; gap: 10px; flex-wrap: wrap; margin: 12px 0; }
        .report-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            border-radius: 6px;
            background: var(--surface);
            border: 1px solid var(--border);
            text-decoration: none;
            color: var(--fg);
            font-weight: 500;
            font-size: 0.9em;
            transition: background 0.15s;
        }
        .report-link:hover { background: var(--hover); text-decoration: none; }
        .report-link .count {
            background: var(--link);
            color: #fff;
            padding: 1px 7px;
            border-radius: 10px;
            font-size: 0.85em;
            font-weight: 700;
        }

        .meta { color: var(--fg-muted); font-size: 0.9em; }
        .note { color: var(--fg-muted); font-size: 0.9em; margin-top: 4px; }
        .section { margin: 24px 0; }
        .footer {
            color: var(--fg-muted);
            font-size: 0.85em;
            margin-top: 40px;
            border-top: 1px solid var(--border);
            padding-top: 12px;
        }

        /* Badges */
        .badge {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 0.8em;
            font-weight: 600;
        }
        .badge-high { background: var(--badge-fail-bg); color: var(--badge-fail-fg); }
        .badge-mod  { background: var(--badge-warn-bg); color: var(--badge-warn-fg); }
        .badge-low  { background: var(--badge-pass-bg); color: var(--badge-pass-fg); }
        .badge-manta { background: var(--caller-manta-bg); color: var(--caller-manta); }
        .badge-tiddit { background: var(--caller-tiddit-bg); color: var(--caller-tiddit); }
        .badge-both { background: var(--caller-both-bg); color: var(--caller-both); }
        .badge-none { color: var(--fg-muted); }
        .badge-na { background: var(--badge-na-bg); color: var(--badge-na-fg); }
        /* SNV/InDel events: per-sample VAF cells */
        .vaf { display: inline-block; padding: 1px 6px; border-radius: 3px; }
        .vaf-high { background: var(--caller-both); color: #ffffff; font-weight: 700; }
        .vaf-mid { background: var(--caller-both-bg); color: var(--caller-both); font-weight: 600; }
        .vaf-low { color: var(--caller-both); }
        .vaf-ref { color: var(--fg-muted); }
        .vaf-gt { font-family: monospace; }
        .vaf-none { font-size: 0.85em; font-style: italic; color: var(--fg-muted); }
        .legend { margin-top: -4px; }
        .legend .vaf, .legend .vaf-none, .legend .multi-mark { margin-right: 2px; }
        .multi-mark { color: var(--fg-muted); font-weight: 700; cursor: help; }
        /* Tabulator click/tap popups (same text as the hover) */
        .tabulator-popup-container { background: var(--surface); color: var(--fg); border: 1px solid var(--border); border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
        .cell-popup { padding: 6px 10px; font-size: 0.85em; white-space: nowrap; }
        .badge-svtype {
            display: inline-block; padding: 1px 5px; border-radius: 3px;
            font-size: 0.75em; font-weight: 700;
        }
        .svtype-DEL { background: var(--badge-fail-bg); color: var(--badge-fail-fg); }
        .svtype-DUP { background: #dbedff; color: #0366d6; }
        .svtype-INV { background: var(--badge-warn-bg); color: var(--badge-warn-fg); }
        .svtype-TRA { background: var(--caller-both-bg); color: var(--caller-both); }
        .svtype-INS { background: var(--badge-pass-bg); color: var(--badge-pass-fg); }
        [data-theme="dark"] .svtype-DUP { background: #0d2240; color: #58a6ff; }

        /* Tab bar */
        .tab-bar { display: flex; gap: 0; }
        .tab-btn .tab-src { font-weight: 400; color: var(--fg-muted); font-size: 0.85em; margin-left: 4px; }
        .tab-btn {
            padding: 8px 16px; cursor: pointer; border: none;
            background: transparent; color: var(--fg-muted); font-size: 0.9em; font-weight: 600;
            border-bottom: 2px solid transparent; margin-bottom: -2px;
        }
        .tab-btn:hover { color: var(--fg); }
        .tab-btn.active { color: var(--link); border-bottom-color: var(--link); }
        .tab-panel { display: none; padding-top: 12px; }
        .tab-panel.active { display: block; }

        .cn-loss { background: var(--badge-fail-bg); color: var(--badge-fail-fg); font-weight: 600; }
        .cn-neutral { background: var(--bg); color: var(--fg-muted); }
        .cn-gain { background: #dbedff; color: #0366d6; font-weight: 600; }
        .cn-amp { background: #0366d6; color: #ffffff; font-weight: 700; }
        [data-theme="dark"] .cn-gain { background: #0d2240; color: #58a6ff; }
        [data-theme="dark"] .cn-amp { background: #1158c7; color: #ffffff; }

        /* Summary cards */
        .cards { display: flex; gap: 16px; flex-wrap: wrap; margin: 20px 0; }
        .card {
            flex: 1; min-width: 150px; padding: 14px 18px;
            background: var(--surface); border: 1px solid var(--border); border-radius: 6px;
        }
        .card .value { font-size: 1.8em; font-weight: 700; color: var(--fg-heading); }
        .card .label { font-size: 0.85em; color: var(--fg-muted); margin-top: 2px; }
        .card .card-sub { font-size: 0.6em; color: var(--fg-muted); font-weight: 400; }
        .card .card-note { font-size: 0.78em; color: var(--fg-muted); margin-top: 4px; font-weight: 400; line-height: 1.35; }
        a.card-link {
            text-decoration: none; color: inherit; cursor: pointer;
            border-left: 3px solid var(--link);
            transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
        }
        a.card-link .label { color: var(--link); }
        a.card-link .label::after { content: " \2197"; font-size: 0.9em; }
        a.card-link:hover { background: var(--hover); border-color: var(--link); box-shadow: 0 2px 8px rgba(0,0,0,0.08); text-decoration: none; }

        /* Audit / methodology sections */
        details { margin: 12px 0; }
        details summary {
            cursor: pointer; font-weight: 600; color: var(--fg-heading);
            padding: 6px 0; font-size: 0.95em;
        }
        details summary:hover { color: var(--link); }
        details[open] summary { margin-bottom: 8px; }
        .audit-content { padding: 0 16px 12px; line-height: 1.7; font-size: 0.92em; }
        .audit-content h4 { margin: 14px 0 6px; color: var(--fg-heading); }
        .audit-content code { background: var(--surface); padding: 1px 5px; border-radius: 3px; font-size: 0.9em; }
        .audit-content table { border-collapse: collapse; margin: 8px 0; font-size: 0.9em; }
        .audit-content th, .audit-content td { padding: 5px 12px; border: 1px solid var(--border); text-align: left; }
        .audit-content th { background: var(--surface); font-weight: 600; }
        .audit-content .tier-arrow { color: var(--fg-muted); font-size: 1.2em; text-align: center; padding: 2px 0; }

        /* Header: title chip, tool strip, jump links */
        .page-header h1 { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
        .version-chip {
            font-size: 0.5em; font-weight: 600; padding: 3px 10px; border-radius: 12px;
            background: var(--surface); border: 1px solid var(--border); color: var(--fg-muted);
        }
        .tool-strip { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 6px; }
        .tool-chip {
            display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px; border-radius: 16px;
            background: var(--surface); border: 1px solid var(--border); font-size: 0.9em;
        }
        .tool-chip .tool-class { font-size: 0.8em; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--fg-muted); }
        .jump-nav { display: flex; gap: 18px; flex-wrap: wrap; margin: 10px 0 0; font-size: 0.9em; }
        .jump-nav a { font-weight: 600; }
        .h2-sub { font-size: 0.6em; font-weight: 400; color: var(--fg-muted); margin-left: 10px; }

        /* Section tool row: tab bar left, value toggle right */
        .section-tools {
            display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap;
            border-bottom: 2px solid var(--border); margin-top: 12px;
        }
        .metric-toggle { display: inline-flex; margin-bottom: 6px; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
        .toggle-btn { padding: 5px 12px; border: none; background: var(--surface); color: var(--fg-muted); font-size: 0.85em; font-weight: 600; cursor: pointer; }
        .toggle-btn.active { background: var(--link); color: #ffffff; }
        .cn-key { display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 0.9em; }
        .dl-row { margin: 8px 0; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
        .dl-hint { font-size: 0.8em; color: var(--fg-muted); }
        .dl-btn {
            font-size: 0.85em; padding: 4px 10px; background: var(--surface); border: 1px solid var(--border);
            border-radius: 4px; color: var(--link); text-decoration: none;
        }

        /* Tabulator overrides */
        .tabulator { font-size: 0.9em; border: 1px solid var(--table-border); }
        .tabulator .tabulator-header { background: var(--table-header-bg); color: var(--fg); }
        .tabulator .tabulator-header .tabulator-col { background: var(--table-header-bg); border-color: var(--table-border); color: var(--fg); }
        .tabulator .tabulator-header .tabulator-col .tabulator-col-content { color: var(--fg); }
        .tabulator .tabulator-tableholder { background: var(--bg); }
        .tabulator-row { background: var(--bg); color: var(--fg); }
        .tabulator-row.tabulator-row-even { background: var(--surface-alt); }
        .tabulator-row.tabulator-row-odd { background: var(--bg); }
        .tabulator-row .tabulator-cell { border-color: var(--table-border); }
        .tabulator-row .tabulator-cell a { color: var(--link); }
        .tabulator .tabulator-header .tabulator-col { border-right: 1px solid var(--table-border); }
        .tabulator .tabulator-header .tabulator-header-filter input {
            background: var(--surface); color: var(--fg); border: 1px solid var(--border);
        }
        /* Tabulator hover — hardcoded per theme for browser compat */
        html[data-theme="light"] .tabulator .tabulator-header .tabulator-col.tabulator-sortable.tabulator-col-sorter-element:hover,
        html:not([data-theme]) .tabulator .tabulator-header .tabulator-col.tabulator-sortable.tabulator-col-sorter-element:hover {
            background-color: #e8e9eb !important;
        }
        html[data-theme="light"] .tabulator-row.tabulator-selectable:hover,
        html:not([data-theme]) .tabulator-row.tabulator-selectable:hover {
            background-color: #f0f1f3 !important;
        }
        html[data-theme="dark"] .tabulator .tabulator-header .tabulator-col.tabulator-sortable.tabulator-col-sorter-element:hover {
            background-color: #3a414b !important;
        }
        html[data-theme="dark"] .tabulator-row.tabulator-selectable:hover {
            background-color: #2d333b !important;
        }

        .igv-link { cursor: pointer; color: var(--link); text-decoration: underline; }

        /* Theme toggle */
        .theme-toggle {
            position: fixed;
            top: 12px;
            right: 16px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 6px 12px;
            cursor: pointer;
            font-size: 1.1em;
            line-height: 1;
            z-index: 1000;
            color: var(--fg);
        }
        .theme-toggle:hover { background: var(--surface-alt); }
    </style>
    <script>
        // Apply theme before paint to prevent flash
        (function() {
            var saved = localStorage.getItem('dashboard-theme');
            var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
            var csm = document.querySelector('meta[name="color-scheme"]');
            if (csm) csm.setAttribute('content', theme);
        })();
    </script>
</head>
<body>

    <button class="theme-toggle" id="themeToggle" title="Toggle dark / light mode" aria-label="Toggle dark mode">&#9790;</button>

    {# ================================================================== #}
    {# Header: title, run line, tool strip, jump links                     #}
    {# ================================================================== #}
    <header class="page-header">
        <h1>{{ title }}{% if pipeline_version %} <span class="version-chip">v{{ pipeline_version }}</span>{% endif %}</h1>
        <p class="meta">
            Generated {{ generated_at }} &middot; {{ n_samples }} samples
            {% if multiqc_report_path %}&middot; <a href="{{ multiqc_report_path }}" target="_blank">MultiQC report &#8599;</a>{% endif %}
        </p>
        <div class="tool-strip">
            {% if 'HaplotypeCaller' in callers %}
            <span class="tool-chip"><span class="tool-class">SNV / InDel</span><a href="https://gatk.broadinstitute.org/hc/en-us/articles/5358864757787-HaplotypeCaller">GATK HaplotypeCaller</a></span>
            {% endif %}
            {% if 'CNVKit' in callers %}
            <span class="tool-chip"><span class="tool-class">CNV</span><a href="https://github.com/etal/cnvkit">CNVKit</a></span>
            {% endif %}
            {% if 'Manta' in callers or 'TIDDIT' in callers %}
            <span class="tool-chip"><span class="tool-class">SV</span>{% if 'Manta' in callers %}<a href="https://github.com/Illumina/manta">Manta</a>{% endif %}{% if 'Manta' in callers and 'TIDDIT' in callers %}&nbsp;+&nbsp;{% endif %}{% if 'TIDDIT' in callers %}<a href="https://github.com/SciLifeLab/TIDDIT">TIDDIT</a>{% endif %}</span>
            {% endif %}
            <span class="tool-chip"><span class="tool-class">Annotation</span><a href="https://pcingola.github.io/SnpEff/">SnpEff</a></span>
        </div>
        <nav class="jump-nav" aria-label="Sections">
            <a href="#samples-section">Samples</a>
            {% if snv %}<a href="#snv-section">SNV / InDel events</a>{% endif %}
            {% if sv_pass %}<a href="#sv-section">SV events</a>{% endif %}
            {% if cn_chr or contig_cn or cn_reg %}<a href="#cn-section">Copy number</a>{% endif %}
            <a href="#methods-section">Methodology</a>
        </nav>
    </header>

    {# ================================================================== #}
    {# Summary cards                                                       #}
    {# ================================================================== #}
    <div class="section" id="summary-section">
        <h2>Summary</h2>
        <div class="cards">
            <div class="card">
                <div class="value">{{ n_samples }}</div>
                <div class="label">Samples</div>
            </div>
            {% if snv or cohort_link %}
            <a class="card card-link" href="{% if snv %}#snv-section{% else %}{{ cohort_link }}" target="_blank{% endif %}">
                <div class="value">{% if cohort_variant_count %}{{ cohort_variant_count }}{% else %}&mdash;{% endif %}</div>
                <div class="label">SNV / InDel sites</div>
                <div class="card-note">{% if snv %}{{ snv.pass }} PASS{% if snv.differing is not none %} &middot; {{ snv.differing }} differ between samples{% endif %}{% else %}all sites in the joint call &middot; opens the all-samples IGV report{% endif %}</div>
            </a>
            {% endif %}
            {% if sv_pass %}
            <a class="card card-link" href="#sv-section">
                <div class="value">{{ sv_pass.both_caller_count }}</div>
                <div class="label">SV events</div>
                <div class="card-note">PASS events called by both Manta and TIDDIT &middot; {{ sv_pass.row_count }} by at least one</div>
            </a>
            {% endif %}
            {% if contig_cn %}
            <a class="card card-link" href="#contig-cn-section">
                <div class="value">{{ contig_cn.change_count }}</div>
                <div class="label">Aneuploid contigs</div>
                <div class="card-note">of {{ contig_cn.row_count }} &middot; TIDDIT whole-contig depth, fold change &lt; 0.76 or &gt; 1.23</div>
            </a>
            {% elif cn_chr %}
            <a class="card card-link" href="#cn-chr-section">
                <div class="value">{{ cn_chr.change_count }}</div>
                <div class="label">Aneuploid chromosomes</div>
                <div class="card-note">of {{ cn_chr.row_count }} &middot; CNVKit segments, fold change &lt; 0.76 or &gt; 1.23</div>
            </a>
            {% endif %}
            {% if cn_reg %}
            <a class="card card-link" href="#cn-regions-section">
                <div class="value">{{ cn_reg.change_count }}</div>
                <div class="label">CN windows with a change</div>
                <div class="card-note">of {{ cn_reg.row_count }} collapsed windows &middot; CNVKit, same thresholds, any sample</div>
            </a>
            {% endif %}
        </div>
        {% if outdir %}
        <p class="meta">
            Complete output: <code>{{ outdir }}</code>{% if report_dir %} &middot; this report bundle: <code>{{ report_dir }}</code>{% endif %}
        </p>
        {% endif %}
        {# Which run produced this bundle. The Seqera run id is a link only when the run was given its workspace URL. #}
        {% if run %}
        <p class="meta">
            Run <code>{{ run.name | e }}</code>{% if run.start %} &middot; started {{ run.start | e }}{% endif %}
            {% if run.commit %}&middot; pipeline commit {% if run.commit_url %}<a href="{{ run.commit_url | e }}" target="_blank"><code>{{ run.commit | e }}</code></a>{% else %}<code>{{ run.commit | e }}</code>{% endif %}{% if run.revision %} ({{ run.revision | e }}){% endif %}{% endif %}
            {% if run.nextflow %}&middot; Nextflow {{ run.nextflow | e }}{% endif %}
            {% if run.seqera_id %}&middot; Seqera run {% if run.seqera_url %}<a href="{{ run.seqera_url | e }}" target="_blank"><code>{{ run.seqera_id | e }}</code> &#8599;</a>{% else %}<code>{{ run.seqera_id | e }}</code>{% endif %}{% endif %}
            {% if run.session %}&middot; session <code>{{ run.session | e }}</code>{% endif %}
        </p>
        {% endif %}
    </div>

    {# ================================================================== #}
    {# Samples: QC + per-caller counts, one row per sample                 #}
    {# ================================================================== #}
    <div class="section" id="samples-section">
        <h2>Samples</h2>
        <p class="note">
            Sequencing QC from MultiQC (mosdepth, Picard, samtools); variant counts from bcftools stats.
            A linked count opens that sample's IGV report. SV counts read PASS / all by each caller's own FILTER column
            &mdash; what each column contains: Methodology &rarr; <em>Samples table: data sources</em>.
        </p>
        <div id="summary-table"></div>
    </div>

    {# ================================================================== #}
    {# SNV / InDel events: PASS sites that differ between samples          #}
    {# ================================================================== #}
    {% if snv %}
    <div class="section" id="snv-section">
        <h2>SNV / InDel events <span class="h2-sub">HaplotypeCaller joint call, all samples</span></h2>
        <p class="note">
            {% if snv.single_sample %}
            One sample in this run: every PASS site it carries{% if snv.has_ann %}, protein-changing first{% endif %}.
            {% elif snv.has_ann %}
            <strong>{{ snv.candidate }}</strong> of {{ snv.pass }} PASS sites differ between samples <em>and</em> change a protein
            (SnpEff impact HIGH or MODERATE); {{ snv.differing }} differ at all.
            {% else %}
            <strong>{{ snv.differing }}</strong> of {{ snv.pass }} PASS sites differ between samples. No SnpEff annotation in this
            run, so no gene columns.
            {% endif %}
            {% if snv.truncated %}Showing the first {{ snv.shown }} by impact, then position.{% endif %}
            Each sample cell is the share of reads carrying the variant (VAF);
            <strong>hover or tap a cell for its genotype, read counts and depth.</strong>
            Every site, with quality and filter tags, is in the CSV and VCF below{% if cohort_link %}; read pileups are in the
            <a href="{{ cohort_link }}" target="_blank">all-samples IGV report &#8599;</a>{% endif %}.
            How rows are chosen: Methodology &rarr; <em>SNV / InDel events table</em>.
        </p>
        <p class="note legend">
            <span class="vaf vaf-high">100&thinsp;%</span> fixed &middot;
            <span class="vaf vaf-mid">45&thinsp;%</span> sub-population or noise &middot;
            <span class="vaf vaf-ref">0&thinsp;%</span> reference &middot;
            <span class="vaf-none">no reads</span> no coverage &middot;
            <span class="multi-mark">&Dagger;</span> multi-allelic site, one row per allele
        </p>
        <div class="section-tools" style="border-bottom:none;margin-top:4px">
            {% if snv.has_ann %}
            <div class="metric-toggle" role="group" aria-label="Rows shown">
                <button class="toggle-btn active snv-view-btn" data-view="coding">Protein-changing</button>
                <button class="toggle-btn snv-view-btn" data-view="all">{% if snv.single_sample %}All PASS sites{% else %}All differing sites{% endif %}</button>
            </div>
            {% else %}<span></span>{% endif %}
            <div class="dl-row" style="margin:0 0 6px">
                {% if snv.csv_link %}<a class="dl-btn" href="{{ snv.csv_link }}" download title="Every site of the joint call: FILTER, annotation, per-sample GT / AD / VAF">&#11015; CSV &middot; all sites</a>{% endif %}
                {% if snv.vcf_link %}<a class="dl-btn" href="{{ snv.vcf_link }}" download title="The annotated cohort VCF (before the multi-allelic split)">&#11015; VCF &middot; all sites</a>{% endif %}
                <a class="dl-btn" href="#" id="snv-csv" title="Exports the rows listed right now: after the view toggle and any column filter, in the current sort">&#11015; CSV &middot; rows shown</a>
            </div>
        </div>
        <div id="snv-table"></div>
    </div>
    {% endif %}

    {# ================================================================== #}
    {# SV events (conditional)                                             #}
    {# ================================================================== #}
    {% if sv_pass %}
    <div class="section" id="sv-section">
        <h2>SV events <span class="h2-sub">Manta + TIDDIT, all samples</span></h2>
        <p class="note">
            {{ sv_pass.both_caller_count }} of {{ sv_pass.row_count }} PASS events are supported by both callers; the rest by one.
            <strong>An overview, not a final call set:</strong> rows are SVDB cross-caller merges that keep Manta's coordinates
            wherever Manta contributed. Verify any locus that matters against the per-caller VCFs in <code>vcf/manta/</code> and
            <code>vcf/tiddit/</code>; how rows are merged and what the cells mean: Methodology &rarr; <em>SV event matrix</em>.
        </p>
        {% if sv_downloads %}
        <div class="dl-row">
            {% if sv_downloads.pass_csv %}<a class="dl-btn" href="{{ sv_downloads.pass_csv }}" download>&#11015; CSV</a>{% endif %}
            {% if sv_downloads.pass_vcf %}<a class="dl-btn" href="{{ sv_downloads.pass_vcf }}" download>&#11015; VCF</a>{% endif %}
        </div>
        {% endif %}
        <div id="sv-pass-table"></div>
    </div>
    {% endif %}

    {# ================================================================== #}
    {# Copy number: three tabs sharing one value toggle (conditional)      #}
    {# ================================================================== #}
    {% if cn_chr or contig_cn or cn_reg %}
    <div class="section" id="cn-section">
        <h2>Copy number <span class="h2-sub">read depth relative to each sample's genome-wide median</span></h2>
        <div class="section-tools">
            <div class="tab-bar">
                {% if cn_chr %}<button class="tab-btn" data-tab="cn-chr-section">Chromosomes <span class="tab-src">CNVKit</span></button>{% endif %}
                {% if contig_cn %}<button class="tab-btn" data-tab="contig-cn-section">Contigs incl. Mito <span class="tab-src">TIDDIT</span></button>{% endif %}
                {% if cn_reg %}<button class="tab-btn" data-tab="cn-regions-section">Windows <span class="tab-src">CNVKit</span></button>{% endif %}
            </div>
            <div class="metric-toggle" role="group" aria-label="Value shown">
                <button class="toggle-btn active cn-metric-btn" data-metric="abs">Fold change</button>
                <button class="toggle-btn cn-metric-btn" data-metric="log2">log2 ratio</button>
            </div>
        </div>
        <p class="note">
            Colours follow log2 in every tab: <span class="cn-loss cn-key">loss &lt; &minus;0.4</span>
            <span class="cn-gain cn-key">gain &gt; 0.3</span> <span class="cn-amp cn-key">amplification &ge; 2.3</span>;
            fold change 1.0 = baseline. The toggle applies to all tabs.
        </p>

        {% if cn_chr %}
        <div class="tab-panel" id="cn-chr-section">
            <p class="note">{{ cn_chr.change_count }} / {{ cn_chr.row_count }} chromosomes with a change in any sample.
                Segment-weighted average per chromosome from CNVKit; the mitochondrial contig and any contig CNVKit cannot bin
                are absent{% if contig_cn %} &mdash; see the Contigs tab{% endif %}.</p>
            {% if cn_downloads.chr %}
            <div class="dl-row"><a class="dl-btn" href="{{ cn_downloads.chr }}" download>&#11015; CSV</a></div>
            {% endif %}
            <div id="cn-chr-table"></div>
        </div>
        {% endif %}

        {% if contig_cn %}
        <div class="tab-panel" id="contig-cn-section">
            <p class="note">{{ contig_cn.change_count }} / {{ contig_cn.row_count }} contigs with a change in any sample.
                Whole-contig median depth ratio from TIDDIT &mdash; <strong>the only table that includes Mito</strong>
                (multi-copy: compare across samples, not against 1). Hover a cell for TIDDIT's raw values.</p>
            {% if cn_downloads.contig %}
            <div class="dl-row"><a class="dl-btn" href="{{ cn_downloads.contig }}" download>&#11015; CSV</a></div>
            {% endif %}
            <div id="contig-cn-table"></div>
        </div>
        {% endif %}

        {% if cn_reg %}
        <div class="tab-panel" id="cn-regions-section">
            <p class="note">{{ cn_reg.change_count }} / {{ cn_reg.row_count }} collapsed windows with a change in any sample
                (adjacent CNVKit bins with the same rounded log2 merged; a new row starts where any sample differs).</p>
            {% if cn_downloads.regions or cn_downloads.matrix %}
            <div class="dl-row">
                {% if cn_downloads.regions %}<a class="dl-btn" href="{{ cn_downloads.regions }}" download>&#11015; CSV</a>{% endif %}
                {% if cn_downloads.matrix %}<a class="dl-btn" href="{{ cn_downloads.matrix }}" download>&#11015; Uncollapsed matrix</a>{% endif %}
            </div>
            {% endif %}
            <div id="cn-reg-table"></div>
        </div>
        {% endif %}
    </div>
    {% endif %}

    {# ================================================================== #}
    {# Methodology / Audit                                                 #}
    {# ================================================================== #}
    <div class="section" id="methods-section">
        <h2>Methodology</h2>

        <details>
            <summary>Soft-filter criteria (GATK VariantFiltration)</summary>
            <div class="audit-content">
                <p>
                    The joint-calling VCF is soft-filtered via <code>GATK4 VariantFiltration</code>
                    as a fallback when VQSR cannot run (no known-sites for custom genomes).
                    This populates the FILTER column but <strong>retains all variants</strong>.
                    Filters use <code>vc.isSNP()</code> / <code>vc.isIndel()</code> JEXL syntax.
                </p>
                <p>
                    <strong>Note:</strong> These quality filters evaluate metrics computed across <em>all samples combined</em>
                    (e.g. total read depth, overall strand bias), not on a per-sample basis.
                    A variant marked PASS means it meets quality thresholds when looking at all samples together,
                    but individual samples may still have low coverage or quality at that site.
                </p>

                <h4>Universal filters (SNPs + INDELs)</h4>
                <table>
                    <tr><th>Filter name</th><th>Expression</th></tr>
                    <tr><td><code>QD_filter</code></td><td>QD &lt; 2.0</td></tr>
                    <tr><td><code>QUAL_filter</code></td><td>QUAL &lt; 30.0</td></tr>
                </table>

                <h4>SNP-only filters (<a href="https://gatk.broadinstitute.org/hc/en-us/articles/360035531112">GATK best practices</a>)</h4>
                <table>
                    <tr><th>Filter name</th><th>Expression</th></tr>
                    <tr><td><code>FS_filter</code></td><td>vc.isSNP() &amp;&amp; FS &gt; 60.0</td></tr>
                    <tr><td><code>SOR_FS_filter</code></td><td>vc.isSNP() &amp;&amp; SOR &gt; 3.0 &amp;&amp; FS &gt; 0.0</td></tr>
                    <tr><td><code>MQ_filter</code></td><td>vc.isSNP() &amp;&amp; MQ &lt; 40.0</td></tr>
                    <tr><td><code>MQRankSum_filter</code></td><td>vc.isSNP() &amp;&amp; MQRankSum &lt; &minus;12.5</td></tr>
                    <tr><td><code>ReadPosRankSum_filter</code></td><td>vc.isSNP() &amp;&amp; ReadPosRankSum &lt; &minus;8.0</td></tr>
                </table>

                <p><em>One deviation from GATK's stock set:</em> the SOR strand-bias filter is gated on FS. At deep clonal
                    coverage SOR alone tagged real mutations that showed zero Fisher-strand bias (Tier-2 validation, 86 samples /
                    343 truth mutations: all 4 truth SNPs lost to SOR had FS = 0); requiring FS &gt; 0 rescues them while
                    flipping the fewest non-truth records of any candidate gate.</p>

                <h4>INDEL-only filters (more lenient per GATK recommendation)</h4>
                <table>
                    <tr><th>Filter name</th><th>Expression</th></tr>
                    <tr><td><code>FS_INDEL_filter</code></td><td>vc.isIndel() &amp;&amp; FS &gt; 200.0</td></tr>
                    <tr><td><code>ReadPosRankSum_INDEL_filter</code></td><td>vc.isIndel() &amp;&amp; ReadPosRankSum &lt; &minus;20.0</td></tr>
                </table>
                <p><em>No SOR, MQ, or MQRankSum filters for INDELs per GATK recommendation.</em></p>

                <p>Config: <code>conf/modules/joint_germline.config</code> &rarr; <code>VARIANTFILTRATION_FALLBACK</code></p>
            </div>
        </details>

        <details>
            <summary>IGV report display VCF preparation</summary>
            <div class="audit-content">
                <p>
                    The cohort and per-sample IGV reports use a post-processed version of the annotated VCFs.
                    This does <strong>not</strong> alter the downloadable VCFs &mdash; only the interactive table display.
                </p>
                <ol>
                    <li><strong>Multi-allelic splitting</strong>: <code>bcftools norm -m-</code> expands multi-allelic sites
                        into one row per ALT allele. The original alleles are preserved in <code>INFO/ORIG_ALT</code>.
                        This is why the report table may show more rows than the joint VCF.</li>
                    <li><strong>FILTER promotion</strong>: The VCF FILTER column is copied into <code>INFO/VCF_FILTER</code>
                        (igv-reports only reads INFO fields, not the fixed FILTER column).</li>
                    <li><strong>VAF calculation</strong>: <code>bcftools +fill-tags FORMAT/VAF</code> adds per-sample
                        variant allele frequency computed from the AD field.</li>
                </ol>
                <p>Source: <code>subworkflows/local/mutation_report/main.nf</code> &rarr; <code>PREPARE_VCF</code> (<code>modules/local/prepare_vcf</code>)</p>
            </div>
        </details>

        <details>
            <summary>SNV / Indel counting (HaplotypeCaller)</summary>
            <div class="audit-content">
                <h4>Filtering pipeline</h4>
                <p>Joint VCF &rarr; soft-filter (GATK VariantFiltration) &rarr; split per sample &rarr; SnpEff annotation</p>
                <table>
                    <tr><th>Step</th><th>Source VCF</th><th>Description</th></tr>
                    <tr>
                        <td><strong>1. Soft-filtered</strong></td>
                        <td><code>*_soft_filtered.vcf.gz</code></td>
                        <td>Joint VCF with FILTER column populated (PASS or quality flags) &mdash; no variants removed</td>
                    </tr>
                    <tr>
                        <td><strong>2. Split per sample</strong></td>
                        <td><code>*.from_joint_calling.vcf.gz</code></td>
                        <td>Individual sample VCFs extracted via <code>bcftools view -s</code>, ref-only genotypes removed</td>
                    </tr>
                    <tr>
                        <td><strong>3. Annotated</strong></td>
                        <td><code>*_snpEff.ann.vcf.gz</code></td>
                        <td>SnpEff functional annotation (gene, impact, protein change)</td>
                    </tr>
                </table>

                <h4>What the HaplotypeCaller column shows</h4>
                <p>
                    The <strong>HaplotypeCaller</strong> count in the Samples table is the total number of
                    non-reference variants per sample after soft filtering and SnpEff annotation (step 3 above).
                    This includes <em>all</em> variants regardless of FILTER status (PASS and flagged).
                    Use the per-sample IGV reports or the cohort report's VCF_FILTER column to distinguish
                    PASS variants from those flagged by soft filters.
                </p>

                <h4>Optional: hard filtering for downstream analysis</h4>
                <p>
                    The reports and downloadable VCFs intentionally include all soft-filtered variants
                    so users can inspect flagged calls in IGV before deciding on thresholds.
                    For downstream analysis requiring a high-confidence call set, consider applying
                    additional hard filters on the exported VCF, for example:
                </p>
                <pre style="background:#f6f8fa;padding:8px 12px;border-radius:4px;font-size:0.85em;overflow-x:auto"><code>bcftools view -f PASS input.vcf.gz \
  | bcftools filter -i 'FORMAT/GQ>=20 && FORMAT/DP>=8' \
  | bcftools filter -i 'FORMAT/VAF>=0.80'   # clonal samples
  # or FORMAT/VAF>=0.05 for population samples</code></pre>
                <p>
                    Adjust thresholds based on your experiment design (ploidy, clonal vs. population,
                    expected allele frequency). With <code>--hard_filter_haplotypecaller_joint</code> (off by default)
                    the pipeline also writes per-sample hard-filtered VCFs (<code>*.hard_filtered*.vcf.gz</code>) with
                    exactly these thresholds: PASS + GQ&ge;20 + DP&ge;8 + ALT allele fraction &ge;0.80 (clonal) /
                    &ge;0.05 (population).
                </p>

                <h4>SNV / InDel events table</h4>
                <p>
                    Built from the same prepared cohort VCF as the all-samples IGV report (post multi-allelic split, so one
                    row per ALT allele). A row is kept when the site is PASS and at least one called sample carries the
                    variant while at least one is called reference &mdash; strain background shared by every sample is
                    left to the IGV report. With SnpEff annotation the default view keeps HIGH and MODERATE impact
                    (the first ANN entry for the row's allele); without it the table has no gene columns and shows every
                    differing site. Rows are ordered by impact, contig, position and cut at {{ snv.shown if snv and snv.truncated else 300 }}
                    when longer. VAF = ALT reads / (REF + ALT reads) from <code>FORMAT/AD</code> (bcftools
                    <code>fill-tags</code> on the prepared VCF), shown as a percent and independent of the genotype
                    call; a sample with no reads at the site reads <em>no reads</em> (the CSV keeps its genotype and
                    leaves the VAF empty) and counts as neither carrier nor reference.
                    On a multi-allelic site (&Dagger;) the split leaves one row per allele, so a sample carrying the
                    other allele is 0 on this row while its VAF here counts REF and this allele only; the CSV lists the
                    original alleles in <code>multiallelic_site_alleles</code>.
                    Downloads: <em>CSV &middot; all sites</em> (<code>data/snv_indel_sites.csv</code>) lists every row of
                    the prepared cohort VCF &mdash; FILTER kept, SnpEff gene / effect / impact / HGVS, a
                    <code>differs_between_samples</code> flag and per-sample GT, AD, DP and VAF (fraction) &mdash; DP is the
                    caller's read depth at the site, AD the reads it assigned to REF and ALT, so DP &ge; REF + ALT and the gap
                    is reads it could not assign (other alleles, ambiguous); <em>VCF &middot;
                    all sites</em> is the cohort VCF under <code>vcf/haplotypecaller/</code> (before the multi-allelic
                    split); <em>CSV &middot; rows shown</em> exports the table as currently filtered and sorted.
                </p>

                <h4>Notes</h4>
                <ul>
                    <li>The cohort card shows unique variant <em>sites</em> in the joint VCF (one row per site), so it is lower than the sum of per-sample counts.</li>
                    <li>The cohort IGV report may show more rows than the card number because <code>bcftools norm -m-</code> splits multi-allelic sites into separate records.</li>
                    <li>All reports include <strong>all non-reference variants</strong> (soft-filtered only) &mdash; use the VCF_FILTER column to identify PASS variants.</li>
                </ul>
            </div>
        </details>

        {# Keep in sync with the maintainer doc docs/variant-calling/sv_merge.md
           (SVDB merge mechanics). This section is the user-facing "how to read"
           view; sv_merge.md is "how it is built". Separate sources for now — a shared
           Jinja include is deferred (see docs/dev-practices/roadmap.md). #}
        {% if sv_pass %}
        <details>
            <summary>SV event matrix (Manta + TIDDIT)</summary>
            <div class="audit-content">
                <p>
                    SVs detected independently by
                    <a href="https://github.com/Illumina/manta">Manta</a> and
                    <a href="https://github.com/SciLifeLab/TIDDIT">TIDDIT</a>,
                    merged into one cohort matrix (<code>sv_cohort_matrix.py</code>).
                    Per-sample columns show the caller(s) that detected the event in that sample:
                    <code>Manta</code>, <code>TIDDIT</code>, <code>Manta+TIDDIT</code>, or <code>-</code> (no matching call).
                </p>
                <h4>How events are merged</h4>
                <ol>
                    <li><strong>Normalise breakends</strong> &mdash; Manta reports inversions and translocations as
                        breakend <em>pairs</em> (two records per junction). Inversion pairs are rewritten as single
                        <code>&lt;INV&gt;</code> records (Manta's own <code>convertInversion.py</code>), and the second
                        mate of every remaining pair is dropped (both callers) &mdash; so one junction is one record.</li>
                    <li><strong>Across samples</strong> &mdash; TIDDIT's per-sample calls are merged with
                        <a href="https://github.com/J35P312/SVDB">SVDB</a> into one multi-sample VCF (Manta is already
                        multi-sample: it is run jointly per experiment). Merging is type-strict; within-file clustering
                        is disabled.</li>
                    <li><strong>Across callers</strong> &mdash; the Manta and TIDDIT cohort VCFs are merged with
                        <code>svdb --merge --priority manta,tiddit</code>. This is the "VCF" download beside the
                        Ensemble SV table (<code>data/sv_cohort_merged_union_pass.vcf.gz</code>): one record per event,
                        one genotype column per sample, and per-caller provenance in INFO
                        (<code>set=Intersection/manta/tiddit/&hellip;</code>, <code>manta_POS</code>,
                        <code>tiddit_POS</code>, per-sample <code>&lt;sample&gt;.tiddit_SAMPLE</code> keys).</li>
                    <li><strong>Caller labels</strong> &mdash; matrix cells are read directly from that merged record:
                        the sample's Manta genotype (with its per-sample <code>FORMAT/FT</code> filter in the PASS view)
                        and the presence of its TIDDIT contribution key. No distance heuristic is involved, so a cell
                        cannot disagree with the merge that produced the row.</li>
                </ol>
                <h4>Which coordinates a merged row shows</h4>
                <p>
                    The <strong>priority caller's</strong>: Manta's split-read breakpoints wherever Manta contributed
                    (typically exact, with breakpoint homology recorded), TIDDIT's read-pair/depth-derived positions
                    otherwise. The non-priority caller's own coordinates are preserved in the cohort VCF
                    (<code>INFO/tiddit_POS</code> / <code>INFO/manta_POS</code>) &mdash; they usually differ by a few bp.</p>
                <h4>Reading the matrix</h4>
                <ul>
                    <li><strong>Merging is type-strict.</strong> A deletion only merges with a deletion, so a
                        low-confidence breakend near a real event can no longer absorb and retype it (that was a failure
                        mode of the previous SURVIVOR-based merge). The cost: when two callers describe the same event
                        with different types they stay as two rows &mdash; rare after the breakend normalisation step.</li>
                    <li>One junction is <strong>one row</strong>: inversion breakend pairs are typed <code>INV</code>,
                        and remaining breakend (<code>BND</code>) rows show the partner position in
                        <code>chrom2</code>/<code>end</code>. The per-sample reports and the Samples table counts still
                        show Manta's raw records, where a junction is two breakend records.</li>
                    <li>"Union" means an event is listed if <em>either</em> caller reported it in at least one sample;
                        <code>Manta+TIDDIT</code> marks the subset supported by both callers in that sample.</li>
                    <li><strong>TIDDIT calls face three extra vetoes in this (PASS) view</strong>, mirroring Manta's own
                        filter design: <code>LowSupport</code> (&lt;6 supporting read pairs+splits), <code>LowQual</code>
                        (TIDDIT quality &lt;40/80) and <code>HighMQ0</code> (&gt;40% ambiguously mapped reads at a
                        breakend). These are <em>soft</em> tags on the merge input: nothing is deleted &mdash; a vetoed
                        call stays in the union view with its reason, and TIDDIT's own published VCF is untouched.</li>
                    <li>A <code>-</code> cell means neither caller supports the event in that sample in this view &mdash;
                        the call may still exist with a non-PASS filter (compare the
                        <code>sv_cohort_matrix_union.csv</code> download, which is built the same way from all calls).
                        With joint Manta the common non-PASS case is a genotype Manta assigned to this sample at another
                        sample's event but with few supporting reads (<code>MinGQ</code>, GQ &lt; 15): present in the union
                        matrix and in the per-sample Manta report, <code>-</code> here.</li>
                    <li><strong>Joint Manta changes what "shared" means.</strong> Because every sample is genotyped at every
                        candidate, an event with strong evidence in one clone and modest evidence in another is reported in
                        both (with each sample's own <code>PR</code>/<code>SR</code> read counts), where per-sample calling
                        showed it in one. Two things are no longer per sample: the breakpoint estimate (one, from pooled
                        reads) and Manta's record-level filters such as <code>MaxDepth</code>, which are evaluated on the
                        pooled depth &mdash; a depth excess confined to one clone no longer flags the record. Depth itself is
                        still visible in the CNVKit/TIDDIT tracks and in <code>INFO/BND_DEPTH</code>.</li>
                    <li><strong>Re-merging at your own settings:</strong> the exact merge inputs are kept under
                        <code>data/sv_merge_inputs/</code>.</li>
                </ul>
                <h4>Why counts differ</h4>
                <ul>
                    <li><strong>SV events card + matrix</strong>: PASS-filtered, deduplicated across callers and samples
                        (<code>sv_cohort_matrix_union_pass.csv</code>)</li>
                    <li><strong>Samples table TIDDIT/Manta columns</strong>: per-sample record counts shown as
                        "PASS / all" from each caller's own VCF &mdash; not deduplicated across callers, and breakend pairs
                        count twice. <strong>CNVKit column</strong>: raw unfiltered count. CNVKit IGV reports show read depth
                        and log2 ratio tracks (~5 kb bins, ±50 kb context); Manta and TIDDIT IGV reports include read
                        alignment views at breakpoints (±500 bp)</li>
                </ul>
                <p>
                    Per-sample "all" counts are much higher because they include non-PASS calls
                    and are not deduplicated. TIDDIT in particular generates many low-confidence calls.
                </p>
            </div>
        </details>
        {% endif %}

        {% if cn_chr or cn_reg %}
        <details>
            <summary>Copy number analysis (CNVKit)</summary>
            <div class="audit-content">
                <p>
                    Copy number is called by <a href="https://github.com/etal/cnvkit">CNVKit</a>
                    using a flat reference (no matched normal pooling).
                </p>
                <h4>Card counts</h4>
                <p>
                    <strong>Aneuploid contigs / chromosomes</strong> card: contigs (from the TIDDIT tab, when TIDDIT runs;
                    otherwise chromosomes from the CNVKit tab) where any sample's log2 ratio is &lt; &minus;0.4 (loss) or
                    &gt; 0.3 (gain) &mdash; same thresholds as the cell colouring.
                    <strong>CN windows with a change</strong> card: collapsed windows where any sample crosses the same
                    thresholds; the card note gives the total number of windows.
                </p>
                <h4>Display values</h4>
                <p>
                    Default: <strong>fold change</strong> = <code>2<sup>log2</sup></code> (depth ratio vs. reference; 1.0 = baseline).
                    Toggle to <strong>log2 ratio</strong> (raw segmented depth vs. flat reference).
                    Colors always track log2: 0 = neutral, negative = loss (red),
                    positive = gain (blue), &ge;2.3 = high amplification (dark blue).
                </p>
                <h4>CN source</h4>
                <p>
                    Segments from <code>*.germline.call.cns</code> (stringent tier &mdash;
                    germline-mode, CI-filtered, stricter segmentation).
                </p>
                <h4>Tabs</h4>
                <p>
                    <strong>Windows</strong>: adjacent bins merged where all samples
                    share the same rounded log2 value; a new row starts where any sample differs.<br>
                    <strong>Chromosomes</strong>: one row per chromosome,
                    weighted-average log2 across CNVKit segments. Fold change is derived from the
                    averaged log2 (<code>2<sup>log2</sup></code>).<br>
                    <strong>Contigs incl. Mito</strong>: TIDDIT's whole-contig depth ratio &mdash; see the next entry.
                </p>
                <h4>Missing chromosomes</h4>
                <p>
                    A contig absent from the CNVKit tables was <strong>not evaluated</strong> &mdash; absence is not a "no change" call.
                    Two known causes:
                </p>
                <ul>
                    <li><strong>The mitochondrial contig is always absent.</strong> CNVKit's <code>fix</code> step drops every bin whose
                        GC content is outside a hard-coded 0.30&ndash;0.70 window (<code>cnvlib/params.py</code>; no CLI override &mdash;
                        <code>--no-gc</code> does not lift it), and yeast mtDNA is ~17&nbsp;% GC. The mask acts upstream of segmentation,
                        so it removes Mito from <em>every</em> CNVKit view &mdash; CN windows, this chromosome table, the CNV VCF and the
                        IGV log2 track. Read Mito from the Contigs tab (TIDDIT). The mask is not Mito-specific: any region outside
                        30&ndash;70&nbsp;% GC vanishes the same silent way (none exist on S288C nuclear chromosomes).</li>
                    <li><strong>Very short contigs (&lt; ~150&nbsp;kb)</strong> may additionally be dropped by CNVKit's WGS binning
                        heuristics (telomeric skip during antitarget generation).</li>
                </ul>
            </div>
        </details>
        {% endif %}

        {% if contig_cn %}
        <details>
            <summary>Contig copy number (TIDDIT fold change)</summary>
            <div class="audit-content">
                <p>
                    Built from <a href="https://github.com/SciLifeLab/TIDDIT">TIDDIT</a>'s per-contig coverage table
                    (<code>&lt;sample&gt;.tiddit.ploidies.tab</code>), written by every TIDDIT run and exported as
                    <code>data/contig_copy_number.csv</code>.
                </p>
                <h4>How the number is computed</h4>
                <p>
                    TIDDIT reports <code>Ploidy = n &times; median depth(contig) &divide; median depth(genome)</code>, where <code>n</code> is the
                    organism ploidy the pipeline passes from the samplesheet <code>ploidy</code> column (<code>-n</code>) and the medians are over
                    50&nbsp;bp bins (zero-coverage bins excluded). The table shows <strong>fold change = Ploidy &divide; n</strong> (and its log2), i.e. depth
                    relative to that sample's own genome-wide median, so values mean the same thing whatever ploidy each sample was labelled
                    with, and are presented exactly like the CNVKit tables (same toggle, colours and thresholds).
                    Hover a cell for TIDDIT's raw ploidy, the <code>n</code> used, and the contig's median depth.
                </p>
                <h4>Reading it</h4>
                <ul>
                    <li><strong>Whole-contig only.</strong> A partial-chromosome gain or an intra-contig deletion shows as a fractional value
                        (1.28 may be "every cell carries 1.28 copies" or "28&nbsp;% of cells carry two"); use the CNVKit windows for sub-chromosomal detail.</li>
                    <li><strong>Mitochondrial DNA is multi-copy</strong>, so <code>Mito</code> is normally well above 1 (about 10 in a healthy haploid
                        cell) and is the number to compare between parent and evolved clones; a drop towards 0 is loss of the mitochondrial genome.
                        This table is the only mtDNA quantification in the report (CNVKit excludes the contig by its GC mask).</li>
                    <li>Colours and the fold change / log2 toggle are shared with the CNVKit tables (log2 &lt; &minus;0.4 loss, &gt; 0.3 gain, &ge; 2.3 amplification).</li>
                    <li>The genome-wide median is dominated by the nuclear genome, so a small contig cannot shift its own baseline.</li>
                    <li><strong>Versus the CNVKit chromosome table</strong>: the two answer the same question with different
                        instruments &mdash; CNVKit is segment-based and can see sub-chromosomal changes but drops Mito (GC mask)
                        and any contig it cannot bin; this table is one median per contig but covers every contig. On nuclear
                        chromosomes they should broadly agree; the fold change / log2 toggle above the tabs applies
                        to all three tables.</li>
                </ul>
            </div>
        </details>
        {% endif %}

        <details>
            <summary>IGV report generation</summary>
            <div class="audit-content">
                <p>Per-sample and cohort reports are generated with
                    <a href="https://github.com/igvteam/igv-reports">igv-reports</a>.
                    Processing steps:</p>
                <ol>
                    <li><strong>Multi-allelic split</strong> &mdash; <code>bcftools norm -m-</code> so each alt allele has its own row</li>
                    <li><strong>FILTER promotion</strong> &mdash; FILTER column copied to <code>INFO/VCF_FILTER</code> (igv-reports only reads INFO)</li>
                    <li><strong>VAF annotation</strong> &mdash; <code>bcftools +fill-tags -- -t FORMAT/VAF</code>
                        (computed as AD[alt] / sum(AD), not AD[alt] / DP; DP includes reads filtered by the caller)</li>
                    <li><strong>Report creation</strong> &mdash; <code>create_report</code> with &plusmn;500 bp flanking, CRAM tracks, GFF3 gene annotations</li>
                    <li><strong>VCF downloads</strong> &mdash; pre-normalization annotated VCFs published to <code>vcf/</code> folder, organized by variant caller; reports link to these files for download</li>
                </ol>
                <p>
                    The cohort report uses the soft-filtered joint VCF (all variants, FILTER column visible).
                    Per-sample reports use the annotated individual VCFs from joint calling.
                    Both include <strong>all non-reference variants</strong> so users can inspect flagged variants in IGV.
                </p>
                <p>
                    <strong>VCF Downloads:</strong> The <code>vcf/</code> folder contains pre-normalization annotated VCFs
                    suitable for sharing and downstream analysis, organized by variant caller
                    (<code>haplotypecaller/</code>, <code>cnvkit/</code>, <code>manta/</code>).
                    These are the canonical variant calls before multi-allelic splitting.
                    See <code>vcf/README.md</code> for details and reproducibility instructions.
                </p>
            </div>
        </details>

        <details>
            <summary>Samples table: data sources</summary>
            <div class="audit-content">
                <table>
                    <tr><th>Column</th><th>Source</th><th>Filter status</th></tr>
                    <tr><td>Cov</td><td>Mosdepth median coverage</td><td>&mdash;</td></tr>
                    <tr><td>Dup %</td><td>Picard MarkDuplicates</td><td>&mdash;</td></tr>
                    <tr><td>Map % / Mapped (M)</td><td>Samtools flagstat</td><td>&mdash;</td></tr>
                    <tr><td>HaplotypeCaller</td><td>bcftools stats (<code>*_snpEff.ann</code>)</td><td>Soft-filtered, annotated (all non-ref variants)</td></tr>
                    <tr><td>CNVKit</td><td>bcftools stats (<code>*.cnvcall</code>)</td><td>Raw (unfiltered)</td></tr>
                    <tr><td>TIDDIT</td><td><code>bcftools view -f PASS</code> record counts (<code>data/*.tiddit.pass_stats.tsv</code>)</td><td>Table shows "PASS / all"; IGV report uses PASS-only</td></tr>
                    <tr><td>Manta</td><td><code>bcftools view -f PASS</code> record counts (<code>data/*.manta.pass_stats.tsv</code>)</td><td>Table shows "PASS / all"; IGV report shows all calls (FILTER column visible)</td></tr>
                </table>
                <p><strong>Manta column.</strong> Manta runs jointly over all samples of an experiment
                    (<code>--joint_manta</code>): every sample is genotyped at every candidate, and a sample's Manta VCF is
                    its column of that joint call with reference-only rows removed and Manta's per-sample filter
                    (<code>FORMAT/FT</code>, e.g. <code>MinGQ</code>) promoted to <code>FILTER</code> &mdash; so an event with
                    strong support in one clone and weak support in another appears in both VCFs, once as PASS and once as
                    MinGQ, instead of being absent from the second. Breakpoints are estimated once from the pooled reads and
                    are identical across samples. Translocations and inversions are breakend <em>pairs</em> (two records per
                    junction), so those counts are records, not events.</p>
                <p>QC and HaplotypeCaller/CNVKit counts are parsed from <code>multiqc_data/</code> (<code>multiqc_general_stats.txt</code> + <code>multiqc_bcftools_stats.txt</code>); the SV "PASS / all" counts come from the <code>pass_stats.tsv</code> files in <code>data/</code> (falling back to the bcftools-stats total when absent).</p>
            </div>
        </details>
    </div>

    {# ================================================================== #}
    {# Footer                                                              #}
    {# ================================================================== #}
    <div class="footer">
        Generated from MultiQC summary data (bcftools stats, Mosdepth, Picard, samtools).<br>
        {% if cn_chr %}CN data: CNVKit .germline.call.cns (stringent, CI-filtered). SV data: Manta + TIDDIT.<br>{% endif %}
        Per-sample igv-reports include GFF3 gene track + CRAM read pileups + FORMAT/VAF.
    </div>

    {# ================================================================== #}
    {# JavaScript                                                          #}
    {# ================================================================== #}
    {% if tabulator_js %}
    <script>{{ tabulator_js }}</script>
    {% else %}
    <script src="https://unpkg.com/tabulator-tables@6.3.0/dist/js/tabulator.min.js"></script>
    {% endif %}
    <script>
        // --- Theme toggle ---
        var __darkMql = window.matchMedia('(prefers-color-scheme: dark)');
        (function() {
            var btn = document.getElementById('themeToggle');
            var root = document.documentElement;
            function currentTheme() {
                return root.getAttribute('data-theme') ||
                    (__darkMql.matches ? 'dark' : 'light');
            }
            function applyTheme(theme) {
                root.setAttribute('data-theme', theme);
                var csm = document.querySelector('meta[name="color-scheme"]');
                if (csm) csm.setAttribute('content', theme);
                btn.textContent = theme === 'dark' ? '\u2600' : '\u263E';
            }
            applyTheme(currentTheme());
            btn.addEventListener('click', function() {
                var next = currentTheme() === 'dark' ? 'light' : 'dark';
                localStorage.setItem('dashboard-theme', next);
                applyTheme(next);
            });
            function onSystemChange(e) {
                if (!localStorage.getItem('dashboard-theme')) {
                    applyTheme(e.matches ? 'dark' : 'light');
                }
            }
            if (__darkMql.addEventListener) {
                __darkMql.addEventListener('change', onSystemChange);
            } else if (__darkMql.addListener) {
                __darkMql.addListener(onSystemChange);
            }
        })();

        // --- Data injected from Python/Jinja2 ---
        const summaryData = {{ summary_data_json }};

        // --- Samples table (QC + per-caller counts) ---
        new Tabulator("#summary-table", {
            data: summaryData,
            layout: "fitDataFill",
            headerSortTristate: true,
            initialSort: [{ column: "sample", dir: "asc" }],
            columns: [
                { title: "Sample", field: "sample", headerFilter: "input", frozen: true, minWidth: 140,
                },
                {
                    title: "Sequencing QC",
                    columns: [
                        { title: "Cov", field: "median_coverage", hozAlign: "right",
                          titleFormatter: function() { return 'Cov<br><span style="font-weight:normal;font-size:0.75em;color:var(--fg-muted)">Mosdepth</span>'; },
                        },
                        { title: "Dup %", field: "dup_pct", hozAlign: "right",
                          titleFormatter: function() { return 'Dup %<br><span style="font-weight:normal;font-size:0.75em;color:var(--fg-muted)">Picard</span>'; },
                          formatter: function(cell) { var v = cell.getValue(); return v != null ? v.toFixed(1) + "%" : ""; } },
                        { title: "Map %", field: "mapped_pct", hozAlign: "right",
                          titleFormatter: function() { return 'Map %<br><span style="font-weight:normal;font-size:0.75em;color:var(--fg-muted)">flagstat</span>'; },
                          formatter: function(cell) { var v = cell.getValue(); return v != null ? v.toFixed(1) + "%" : ""; } },
                        { title: "Mapped (M)", field: "mapped_reads_m", hozAlign: "right",
                          titleFormatter: function() { return 'Mapped (M)<br><span style="font-weight:normal;font-size:0.75em;color:var(--fg-muted)">flagstat</span>'; },
                          formatter: function(cell) { var v = cell.getValue(); return v != null ? v.toFixed(1) : ""; } },
                    ]
                },
                {
                    title: "SNV / Indel",
                    columns: [
                        { title: "HaplotypeCaller", field: "hc_variants", hozAlign: "right", sorter: "number",
                          titleFormatter: function() { return 'HaplotypeCaller<br><span style="font-weight:normal;font-size:0.75em;color:var(--fg-muted)">soft-filtered</span>'; },
                          formatter: function(cell) {
                              var row = cell.getRow().getData();
                              var v = cell.getValue();
                              if (v == null) return "";
                              if (row.igv_link) {
                                  return '<a class="igv-link" href="' + row.igv_link + '" target="_blank">' + v + '</a>';
                              }
                              return v;
                          }
                        },
                    ]
                },
                {
                    title: "CNV",
                    columns: [
                        { title: "CNVKit", field: "cnvkit_events", hozAlign: "right", sorter: "number",
                          titleFormatter: function() { return 'CNVKit<br><span style="font-weight:normal;font-size:0.75em;color:var(--fg-muted)">raw unfiltered, depth + log2 ratio</span>'; },
                          formatter: function(cell) {
                              var row = cell.getRow().getData();
                              var v = cell.getValue();
                              if (v == null) return "";
                              if (row.cnvkit_igv_link) {
                                  return '<a class="igv-link" href="' + row.cnvkit_igv_link + '" target="_blank">' + v + '</a>';
                              }
                              return v;
                          }
                        },
                    ]
                },
                {
                    title: "SV",
                    columns: [
                        { title: "TIDDIT", field: "tiddit_svs", hozAlign: "right", sorter: "number",
                          titleFormatter: function() { return 'TIDDIT<br><span style="font-weight:normal;font-size:0.75em;color:var(--fg-muted)">PASS / all</span>'; },
                          formatter: function(cell) {
                              var row = cell.getRow().getData();
                              var total = cell.getValue();
                              if (total == null) return "";
                              var pass = row.tiddit_pass;
                              var label = (pass != null) ? pass + ' / ' + total : '' + total;
                              if (row.tiddit_igv_link) {
                                  return '<a class="igv-link" href="' + row.tiddit_igv_link + '" target="_blank" title="PASS-filtered variants shown in IGV report. Download raw VCF from the report toolbar.">' + label + '</a>';
                              }
                              return label;
                          }
                        },
                        { title: "TIDDIT PASS", field: "tiddit_pass", visible: false },
                        { title: "Manta", field: "manta_svs", hozAlign: "right", sorter: "number",
                          titleFormatter: function() { return 'Manta<br><span style="font-weight:normal;font-size:0.75em;color:var(--fg-muted)">PASS / all</span>'; },
                          formatter: function(cell) {
                              var row = cell.getRow().getData();
                              var total = cell.getValue();
                              if (total == null) return "";
                              var pass = row.manta_pass;
                              var label = (pass != null) ? pass + ' / ' + total : '' + total;
                              if (row.manta_igv_link) {
                                  return '<a class="igv-link" href="' + row.manta_igv_link + '" target="_blank" title="IGV report shows ALL Manta calls with the FILTER column visible; the first number is the PASS subset.">' + label + '</a>';
                              }
                              return label;
                          }
                        },
                        { title: "Manta PASS", field: "manta_pass", visible: false },
                    ]
                },
                { title: "IGV Report", field: "igv_link", visible: false },
                { title: "CNVKit IGV", field: "cnvkit_igv_link", visible: false },
                { title: "Manta IGV", field: "manta_igv_link", visible: false },
                { title: "TIDDIT IGV", field: "tiddit_igv_link", visible: false },
            ],
        });

        // --- CN/SV tables (conditional) ---
        {# Shared by every copy-number table (CNVKit windows, CNVKit chromosomes, TIDDIT contigs) #}
        {% if cn_reg or cn_chr or contig_cn %}
        var cnMetric = "abs"; // "abs" or "log2"
        var cnTableBuilders = {};  // panel id -> function creating that panel's Tabulator table
        var cnTables = {};         // panel id -> the table, once its tab has been shown

        // Color always by log2 — ploidy-independent
        function log2Class(v) {
            if (v < -0.4) return 'cn-loss';
            if (v <= 0.3) return 'cn-neutral';
            if (v >= 2.3) return 'cn-amp';
            return 'cn-gain';
        }
        // Tabulator formatter — color by log2, display switches with toggle
        function cnCellFormatter(cell) {
            var log2 = cell.getValue();
            if (log2 == null) return '';
            var cls = log2Class(log2);
            var display;
            if (cnMetric === "log2") {
                display = log2.toFixed(4);
            } else {
                var row = cell.getRow().getData();
                var fcField = cell.getField().replace('_log2', '_fold_change');
                var fc = row[fcField];
                display = (fc != null) ? fc.toFixed(2) : Math.pow(2, log2).toFixed(2);
            }
            return '<span class="' + cls + '" style="display:inline-block;padding:1px 6px;border-radius:3px">' + display + '</span>';
        }
        {% endif %}

        {% if cn_reg %}
        var cnRegSamples = {{ cn_reg.samples | tojson }};
        function buildCnRegColumns(samples) {
            var cols = [
                { title: "Chr", field: "chromosome", headerFilter: "list", headerFilterParams: { valuesLookup: true }, frozen: true, minWidth: 80 },
                { title: "Start", field: "start", sorter: "number", hozAlign: "right", formatter: function(c) { return c.getValue().toLocaleString(); } },
                { title: "End", field: "end", sorter: "number", hozAlign: "right", formatter: function(c) { return c.getValue().toLocaleString(); } },
                { title: "Chr Length", field: "chr_length", sorter: "number", hozAlign: "right", formatter: function(c) { var v = c.getValue(); return v ? v.toLocaleString() : ""; } },
                { title: "Span (kb)", field: "span_kb", sorter: "number", hozAlign: "right" },
            ];
            samples.forEach(function(s) {
                cols.push({
                    title: s.replace(/-/g, '\u2011'), field: s + "_log2", hozAlign: "center",
                    sorter: "number", formatter: cnCellFormatter
                });
            });
            return cols;
        }

        cnTableBuilders['cn-regions-section'] = function() { return new Tabulator("#cn-reg-table", {
            data: {{ cn_reg.rows | tojson }},
            layout: "fitDataFill", height: 500,
            headerSortTristate: true, columns: buildCnRegColumns(cnRegSamples),
        }); };
        {% endif %}

        {% if cn_chr %}
        // --- Chromosome-level CN Tabulator table ---
        var cnChrSamples = {{ cn_chr.samples | tojson }};
        function buildCnChrColumns(samples) {
            var cols = [
                { title: "Chr", field: "chromosome", headerFilter: "list", headerFilterParams: { valuesLookup: true }, frozen: true, minWidth: 80 },
                { title: "Length", field: "length", sorter: "number", hozAlign: "right", formatter: function(c) { return c.getValue().toLocaleString(); } },
            ];
            samples.forEach(function(s) {
                cols.push({
                    title: s.replace(/-/g, '\u2011'), field: s + "_log2", hozAlign: "center",
                    sorter: "number", formatter: cnCellFormatter
                });
            });
            return cols;
        }

        cnTableBuilders['cn-chr-section'] = function() { return new Tabulator("#cn-chr-table", {
            data: {{ cn_chr.rows | tojson }},
            layout: "fitDataFill",  // no height: the table grows to its rows (one per chromosome)
            headerSortTristate: true, columns: buildCnChrColumns(cnChrSamples),
        }); };
        {% endif %}

        {% if contig_cn %}
        // --- Contig copy number (TIDDIT fold change) ---
        var contigCnSamples = {{ contig_cn.samples | tojson }};
        // Same columns/formatter as the CNVKit chromosome table (fields <sample>_log2, display via
        // the shared fold-change/log2 toggle); the TIDDIT-specific values go in the cell tooltip.
        function buildContigCnColumns(samples) {
            var cols = [
                { title: "Contig", field: "chromosome", headerFilter: "list", headerFilterParams: { valuesLookup: true }, frozen: true, minWidth: 90 },
            ];
            samples.forEach(function(s) {
                cols.push({
                    title: s.replace(/-/g, '\u2011'), field: s + "_log2", hozAlign: "center", sorter: "number",
                    formatter: cnCellFormatter,
                    tooltip: function(e, cell) {
                        var row = cell.getRow().getData();
                        if (row[s + '_log2'] == null) return '';
                        return 'TIDDIT ploidy ' + row[s + '_tiddit_ploidy'] + ' (n=' + row[s + '_n'] + '), median depth ' + row[s + '_median_cov'] + 'x';
                    }
                });
            });
            return cols;
        }
        cnTableBuilders['contig-cn-section'] = function() { return new Tabulator("#contig-cn-table", {
            data: {{ contig_cn.rows | tojson }},
            layout: "fitDataFill",  // no height: the table grows to its rows (one per contig)
            headerSortTristate: true, columns: buildContigCnColumns(contigCnSamples),
        }); };
        {% endif %}

        {% if cn_reg or cn_chr or contig_cn %}
        // Toggle: update all CN Tabulator tables (color stays log2-based)
        document.querySelectorAll('.cn-metric-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.cn-metric-btn').forEach(function(b) { b.classList.remove('active'); });
                btn.classList.add('active');
                cnMetric = btn.getAttribute('data-metric');
                Object.keys(cnTables).forEach(function(k) { if (cnTables[k].initialized) cnTables[k].redraw(true); });
            });
        });
        {% endif %}

        {% if sv_pass %}
        // SV caller badge formatter
        var svSamples = {{ sv_pass.samples | tojson }};
        function callerBadge(val) {
            if (!val || val === '-') return '<span class="badge-none">-</span>';
            if (val.indexOf('+') > -1) return '<span class="badge badge-both">' + val + '</span>';
            if (val === 'Manta') return '<span class="badge badge-manta">Manta</span>';
            if (val === 'TIDDIT') return '<span class="badge badge-tiddit">TIDDIT</span>';
            return '<span class="badge">' + val + '</span>';
        }
        function svtypeBadge(cell) {
            var v = cell.getValue();
            return '<span class="badge-svtype svtype-' + v + '">' + v + '</span>';
        }
        function buildSvColumns(samples) {
            var cols = [
                { title: "Chr", field: "chrom", headerFilter: "list", headerFilterParams: { valuesLookup: true }, frozen: true, minWidth: 80 },
                { title: "Pos", field: "pos", sorter: "number", hozAlign: "right", formatter: function(c) { return c.getValue().toLocaleString(); } },
                { title: "Chr2", field: "chrom2", minWidth: 70 },
                { title: "End", field: "end", sorter: "number", hozAlign: "right", formatter: function(c) { return c.getValue().toLocaleString(); } },
                { title: "Type", field: "svtype", headerFilter: "list", headerFilterParams: { valuesLookup: true }, formatter: svtypeBadge, minWidth: 80 },
                { title: "Length", field: "svlen", sorter: "number", hozAlign: "right", formatter: function(c) { var v = c.getValue(); return v ? v.toLocaleString() : '0'; } },
            ];
            samples.forEach(function(s) {
                cols.push({
                    title: s.replace(/-/g, '\u2011'), field: s, hozAlign: "center",
                    formatter: function(cell) { return callerBadge(cell.getValue()); },
                    headerFilter: "list", headerFilterParams: { valuesLookup: true },
                });
            });
            return cols;
        }

        new Tabulator("#sv-pass-table", {
            data: {{ sv_pass.rows | tojson }},
            layout: "fitDataFill", height: 600,  // fixed height, not a maximum: Tabulator 6.3 stalls on the max-height option here
            headerSortTristate: true, columns: buildSvColumns(svSamples),
            initialSort: [{ column: "chrom", dir: "asc" }, { column: "pos", dir: "asc" }],
        });
        {% endif %}

        {% if snv %}
        // --- SNV / InDel events table ---
        var snvSamples = {{ snv.samples | tojson }};
        // VAF shown as a whole percent (the field and the CSV keep the fraction); GT + AD on hover.
        function vafCell(cell) {
            var v = cell.getValue();
            if (v == null) {
                var d = cell.getRow().getData(), s = cell.getField().replace(/_vaf$/, '');
                if (/^[0,]+$/.test(d[s + '_ad'] || '')) return '<span class="vaf-none">no reads</span>';  // AD 0,0
                var gt = d[s + '_gt'];   // a genotype without read counts at all: show it as text
                return (!gt || !/[0-9]/.test(gt)) ? '' : '<span class="vaf-gt">' + gt + '</span>';
            }
            var cls = v >= 0.8 ? 'vaf-high' : (v >= 0.2 ? 'vaf-mid' : (v > 0 ? 'vaf-low' : 'vaf-ref'));
            return '<span class="vaf ' + cls + '">' + Math.round(v * 100) + '&thinsp;%</span>';
        }
        function vafTooltip(e, cell) {
            var s = cell.getField().replace(/_vaf$/, ''), d = cell.getRow().getData();
            if (d[s + '_gt'] == null) return '';
            // one format for every cell; a no-reads cell only gets a bracket at the end
            var text = s + ': GT ' + d[s + '_gt'] + ', AD ' + d[s + '_ad'] + (d[s + '_dp'] == null ? '' : ', DP ' + d[s + '_dp'])
                     + (d[s + '_vaf'] == null ? '' : ', VAF ' + d[s + '_vaf']);
            if (d[s + '_vaf'] == null && /^[0,]+$/.test(d[s + '_ad'] || '')) {
                text += (d[s + '_dp'] > 0) ? ' (no reads of REF or this allele; see \u2021)' : ' (no reads)';
            }
            return text;
        }
        function cellPopup(builder) {   // click / tap shows what hover shows: touch screens have no hover
            return function(e, cell) { var t = builder(e, cell); return t ? '<div class="cell-popup">' + t + '</div>' : ''; };
        }
        function changeText(e, cell) { var d = cell.getRow().getData(); return d.ref + ' > ' + d.alt + (d.orig_alt ? '  (multi-allelic: ' + d.orig_alt + ')' : ''); }
        function impactBadge(cell) {
            var v = cell.getValue();
            if (!v) return '';
            var cls = { HIGH: 'badge-high', MODERATE: 'badge-mod', LOW: 'badge-low' }[v] || 'badge-na';
            return '<span class="badge ' + cls + '">' + v + '</span>';
        }
        var snvCols = [
            { title: "Chr", field: "chrom", headerFilter: "list", headerFilterParams: { valuesLookup: true }, frozen: true, minWidth: 80 },
            { title: "Pos", field: "pos", sorter: "number", hozAlign: "right", formatter: function(c) { return c.getValue().toLocaleString(); } },
            { title: "Ref > Alt", field: "change", width: 130,
              formatter: function(cell) {
                  var d = cell.getRow().getData();
                  return (d.orig_alt ? '<span class="multi-mark" title="Multi-allelic site, one row per allele: ' + d.orig_alt + '. A sample carrying the other allele is 0 here; its share counts REF and this allele only.">\u2021</span> ' : '') + d.change;
              },
              tooltip: changeText, clickPopup: cellPopup(changeText),
              accessorDownload: function(value, data) { return data.ref + '>' + data.alt; } },  // full alleles in the CSV
            {% if snv.has_ann %}
            { title: "Gene", field: "gene", headerFilter: "input", width: 110, tooltip: true },
            { title: "Effect", field: "effect", headerFilter: "list", headerFilterParams: { valuesLookup: true }, width: 170, tooltip: true },
            { title: "Impact", field: "impact", headerFilter: "list", headerFilterParams: { valuesLookup: true }, formatter: impactBadge, width: 110 },
            { title: "Protein", field: "hgvs_p", width: 140, tooltip: true },
            {% endif %}
        ];
        snvSamples.forEach(function(s) {
            // titleDownload: the CSV header keeps the real sample id (the display title uses a non-breaking hyphen)
            snvCols.push({
                title: s.replace(/-/g, '\u2011') + '<br><span style="font-weight:normal;font-size:0.75em;color:var(--fg-muted)">VAF %</span>',
                titleFormatter: "html", titleDownload: s + " VAF", field: s + "_vaf",
                hozAlign: "center", sorter: "number", formatter: vafCell, tooltip: vafTooltip, clickPopup: cellPopup(vafTooltip),
            });
            // genotype and allele depths: never shown (they are on hover), always in the "rows shown" CSV
            snvCols.push({ title: s + " GT", field: s + "_gt", visible: false, download: true });
            snvCols.push({ title: s + " AD", field: s + "_ad", visible: false, download: true });
            snvCols.push({ title: s + " DP", field: s + "_dp", visible: false, download: true });
        });
        var snvRows = {{ snv.rows | tojson }};
        var snvTable = new Tabulator("#snv-table", {
            data: snvRows,
            layout: "fitDataFill", height: Math.min(520, 70 + 26 * snvRows.length),  // fixed height: see the SV table
            headerSortTristate: true, columns: snvCols,
        });
        function isCoding(data) { return data.impact === 'HIGH' || data.impact === 'MODERATE'; }
        {% if snv.has_ann %}
        snvTable.on("tableBuilt", function() { snvTable.setFilter(isCoding); });
        document.querySelectorAll('.snv-view-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.snv-view-btn').forEach(function(b) { b.classList.remove('active'); });
                btn.classList.add('active');
                if (btn.getAttribute('data-view') === 'coding') snvTable.setFilter(isCoding); else snvTable.clearFilter();
            });
        });
        {% endif %}
        document.getElementById('snv-csv').addEventListener('click', function(e) {
            e.preventDefault();
            snvTable.download("csv", "snv_indel_events.csv", {}, "active");
        });
        {% endif %}

        // --- Framed preview (Seqera Platform Outputs tab) ---
        // The Platform shows a report in an iframe sandboxed without allow-downloads: links to pages open,
        // downloads are silently blocked, and pop-ups inherit the sandbox. Say so next to every download row
        // and point at the Outputs-tab entries (tower.yml) that carry the same files.
        if (window.self !== window.top) {
            document.querySelectorAll('.dl-row').forEach(function(row) {
                var hint = document.createElement('span');
                hint.className = 'dl-hint';
                hint.textContent = 'Inside this preview frame a click cannot download \u2014 right-click a button and choose \u201cOpen link in new tab\u201d, or use the same file in the run\u2019s Outputs tab.';
                row.appendChild(hint);
            });
            var viewCsv = document.getElementById('snv-csv');
            if (viewCsv) viewCsv.style.display = 'none';   // a browser-generated file cannot leave the sandbox at all
        }

        // --- Tabs (copy-number section) ---
        // The panel's table is built the first time the tab is shown and redrawn on later visits.
        {% if not (cn_reg or cn_chr or contig_cn) %}var cnTableBuilders = {}, cnTables = {};{% endif %}
        function activateTab(panelId) {
            var panel = document.getElementById(panelId);
            if (!panel || !panel.classList.contains('tab-panel')) return false;
            var section = panel.closest('.section');
            section.querySelectorAll('.tab-btn[data-tab]').forEach(function(b) {
                b.classList.toggle('active', b.getAttribute('data-tab') === panelId);
            });
            section.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.toggle('active', p.id === panelId); });
            if (!cnTables[panelId] && cnTableBuilders[panelId]) cnTables[panelId] = cnTableBuilders[panelId]();
            else if (cnTables[panelId] && cnTables[panelId].initialized) cnTables[panelId].redraw(true);
            return true;
        }
        document.querySelectorAll('.tab-btn[data-tab]').forEach(function(btn) {
            btn.addEventListener('click', function() { activateTab(btn.getAttribute('data-tab')); });
        });
        document.querySelectorAll('.tab-bar').forEach(function(bar) {
            var first = bar.querySelector('.tab-btn[data-tab]');
            if (first) activateTab(first.getAttribute('data-tab'));
        });
        // A card or link that targets a panel (e.g. #contig-cn-section) opens its tab and scrolls to the section.
        function openHashTab() {
            var id = location.hash.slice(1);
            if (id && activateTab(id)) document.getElementById(id).closest('.section').scrollIntoView();
        }
        window.addEventListener('hashchange', openHashTab);
        openHashTab();
    </script>
</body>
</html>