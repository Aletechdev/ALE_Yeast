// Branch probe for a -c config file: the same operators as the .nf probe, as config code.
params.pa = true
params.pb = false
params.px = null
params.py = 'y'
if (params.pa && params.pb)
    params.pc = 'both'
else
    params.pc = 'not both'
process {
    withName: 'NO_SUCH_PROCESS' {
        ext.args   = { params.pa && params.pb ? 'both' : 'not' }
        ext.when   = { params.pa || params.pb }
        ext.prefix = { params.px ?: params.py ?: 'z' }
    }
}
