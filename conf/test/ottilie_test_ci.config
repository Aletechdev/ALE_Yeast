/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Ottilie test dataset — streamed from the PUBLIC Azure Blob (no credentials, no SAS)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same 2-sample / 4-chromosome test as `ottilie_test`, but every input is an https URL
    under the published `ottilie/v1/` prefix instead of a local data/ottilie/ path, so it
    runs on a fresh checkout with NO prior download_test_data.sh / generate_test_data.sh.

    Usage: bash bin/test_ottilie_blob.sh
       or: nextflow run main.nf -profile ottilie_test_ci,azureD4as,docker \
             --snpeff_cache <local dir holding R64-1-1.105/>

    ONE INPUT CANNOT BE A URL — the SnpEff cache. It is a *directory* param: the pipeline
    validates it with `file(...).isDirectory()` and stages the whole tree
    (subworkflows/local/annotation_cache_initialisation/main.nf), and Nextflow's http
    provider has no directory listing, so an https prefix cannot be walked or staged. It
    is published separately as `snpeff_cache.tar.gz` (~23 MB) for exactly this reason —
    `bin/test_ottilie_blob.sh` fetches + untars it into the local dir defaulted below
    BEFORE launching. Everything else (FASTQs, FASTA, GenBank, GFF3, samplesheet) is a
    single file and streams straight from the URL.

    Override the host / version with OTTILIE_BLOB_BASE (e.g. a v2 prefix or a mirror).
    Publishing + provenance: docs/benchmarking/ottilie_xenobiotic_ale/DATA_PROVENANCE.md
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Stable public base URL (container + versioned prefix); provisioned by infra/azure/.
def blob_base  = System.getenv('OTTILIE_BLOB_BASE') ?: 'https://aletestdatapublic.blob.core.windows.net/releases/ottilie/v1'
def blob_files = "${blob_base}/files"
// Local dir the launcher untars snpeff_cache.tar.gz into (must contain R64-1-1.105/).
def snpeff_dir = System.getenv('OTTILIE_SNPEFF_CACHE') ?: "${projectDir}/.ottilie_ci_cache/snpeff_cache"

params {
    config_profile_name        = 'Ottilie Test Profile (public blob)'
    config_profile_description = 'Minimal yeast ALE test streamed from the public Azure Blob — 2 samples, 4 chromosomes'

    // Input — the published samplesheet whose fastq_1/fastq_2 are per-file public URLs
    input                      = "${blob_base}/samplesheet_test_blob.csv"

    // Reference (4-chromosome subset of S288C R64-1-1)
    genome                     = null
    igenomes_ignore            = true
    fasta                      = "${blob_files}/S288C_reference_test/S288C_R64_test.fa"
    genbank                    = "${blob_files}/S288C_reference_test/S288C_R64_test.gb"
    // chr_dir is a *directory* param (Control-FREEC only) and cannot be an https prefix.
    // Control-FREEC is not in `tools` below, so null is equivalent here — see the local
    // ottilie_test profile if you need it.
    chr_dir                    = null

    // Annotation — see the header: directory param, staged locally by the launcher
    snpeff_db                  = 'R64-1-1.105'
    snpeff_cache               = snpeff_dir

    // Tools — identical to the local ottilie_test profile
    tools                      = 'snpeff,cnvkit,tiddit,manta,haplotypecaller'
    skip_tools                 = 'baserecalibrator'

    // Joint germline calling
    joint_germline                    = true
    split_haplotypecaller_joint_vcf   = true
    hard_filter_haplotypecaller_joint = true

    // Mutation report — fasta_fai intentionally NOT set (exercises SAMTOOLS_FAIDX), same as ottilie_test
    report_gff3                = "${blob_files}/S288C_reference/S288C_R64.gff3"

    // Performance
    split_fastq                = 0
}
