/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running Ottilie yeast ALE test dataset
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal test with 2 samples (parent + evolved) on 4 chromosomes (I, IV, VII, XV).
    Truth variants: 4 SNVs + 1 whole-chromosome duplication (chr I) in CBR110-15-R3a.
    Source: Ottilie et al., Commun Biol 5:128 (2022), SRR10985539 + SRR10985585.

    Usage: `nextflow run main.nf -profile ottilie_test,azureD4as,docker`

    Data: Test FASTQs (~360 MB) and reference (~35 MB) live under data/ottilie/ and are
    gitignored. Generate locally with:
      bash docs/benchmarking/ottilie_xenobiotic_ale/01_data_retrieval/generate_test_data.sh
    For a fresh machine, fetch data + samplesheet with download_test_data.sh (public blob, no creds).
    For cloud/CI, use the separate blob-URL samplesheet (samplesheet_test_blob.csv) + the post-1.0.0
    ottilie_test_ci streaming profile — do NOT rewrite this local samplesheet to URLs.
    See docs/benchmarking/ottilie_xenobiotic_ale/DATA_PROVENANCE.md; provisioning in infra/azure/.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Ottilie Test Profile'
    config_profile_description = 'Minimal yeast ALE test — 2 samples, 4 chromosomes, all variant callers'

    // Input
    input                      = "${projectDir}/data/ottilie/samplesheet_test.csv"

    // Reference (4-chromosome subset of S288C R64-1-1)
    genome                     = null
    igenomes_ignore            = true
    fasta                      = "${projectDir}/data/ottilie/S288C_reference_test/S288C_R64_test.fa"
    chr_dir                    = "${projectDir}/data/ottilie/S288C_reference_test/chromosomes"
    genbank                    = "${projectDir}/data/ottilie/S288C_reference_test/S288C_R64_test.gb"

    // Annotation
    snpeff_db                  = 'R64-1-1.105'
    snpeff_cache               = "${projectDir}/data/ottilie/S288C_reference_test/snpeff_cache"

    // Tools
    tools                      = 'snpeff,cnvkit,tiddit,manta,haplotypecaller'
    skip_tools                 = 'baserecalibrator'

    // Joint germline calling
    joint_germline                    = true
    split_haplotypecaller_joint_vcf   = true
    hard_filter_haplotypecaller_joint = true

    // Mutation report (enable via CLI: --generate_reports)
    // generate_reports stays false here — opt-in via CLI so existing runs unaffected
    // NOTE: fasta_fai intentionally NOT set — the report now uses the pipeline's
    // provided-or-generated .fai (SAMTOOLS_FAIDX), exercising that auto-gen path in the test.
    report_gff3                = "${projectDir}/data/ottilie/S288C_reference/S288C_R64.gff3"
    report_filter_config       = "${projectDir}/docs/igvreports/filter_config.yaml"
    report_cohort_template     = "${projectDir}/docs/igvreports/custom_template.html"
    report_sample_template     = "${projectDir}/docs/igvreports/custom_template_sample.html"
    report_index_script        = "${projectDir}/docs/igvreports/generate_index.py"
    report_templates_dir       = "${projectDir}/docs/igvreports/templates"
    report_multiqc_path        = "multiqc_report.html"

    // Performance
    split_fastq                = 0
}
