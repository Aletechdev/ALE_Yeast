/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Ottilie — the shared CALLING RECIPE, independent of where the data lives
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by every ottilie profile. Holds ONLY what does not change between transports:
    which callers run, how joint germline calling is configured, the SnpEff DB version.

    Paths belong in the including profile, never here — that is the one axis that differs:

        ottilie_test.config       local files under data/ottilie/
        ottilie_test_ci.config    public https URLs (no credentials; snpeff cache untarred locally)
        ottilie_test_az.config    az:// on the private aletest container    (Azure Batch / Seqera)
        ottilie_pilot_az.config   az:// full-depth pilot, all 16 chromosomes (Azure Batch / Seqera)

    ⚠️ WHY THIS FILE EXISTS. This block was previously copy-pasted into every profile AND into
    conf/params_ottilie_*.yml — four copies of one tool list. Changing the callers meant changing
    it in four places, and nothing failed if you missed one: the run simply used a different set of
    tools than the run you were comparing it against. Keep additions here, not in the profiles.

    ⚠️ Changing `tools` invalidates cross-run comparisons. The published baselines
    (az://aletest/seqera-runs/2026-08-06-04 and az://aletest/ottilie-azurebatch-out) were produced
    with exactly this list; a different one changes both the deliverables and the container image
    set. See docs/dev-practices/output_comparison.md.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // No iGenomes — this is a custom yeast reference in every variant.
    genome                     = null
    igenomes_ignore            = true

    // Annotation DB version. The cache itself is a path, so it lives in the profiles.
    snpeff_db                  = 'R64-1-1.105'

    // Tier-1 tools. ⚠️ No controlfreec: Tier-2, and its ASSESS_SIGNIFICANCE step is auto-skipped at
    // ploidy 1 (every ottilie sample), so it only adds a container image and a failure-prone step.
    // ⚠️ baserecalibrator MUST stay skipped — the custom reference has no known-sites VCFs, and
    // dropping this aborts the run with a Nextflow join error rather than a GATK error.
    tools                      = 'snpeff,cnvkit,tiddit,manta,haplotypecaller'
    skip_tools                 = 'baserecalibrator'

    // Joint germline calling — the ALE default (all samples are status=0/normal).
    joint_germline                    = true
    split_haplotypecaller_joint_vcf   = true
    hard_filter_haplotypecaller_joint = true

    // Joint Manta — one run per experiment, every sample genotyped at every candidate SV, then
    // split back per sample (hom-ref dropped, FT→FILTER) so downstream paths are unchanged.
    joint_manta                       = true

    // fasta_fai intentionally NOT set anywhere — the pipeline generates it (SAMTOOLS_FAIDX), which
    // keeps that path exercised and keeps the task graph identical across transports.

    // Performance
    split_fastq                = 0
}
