/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Azure Batch executor — LOCAL head job, remote tasks
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs the Nextflow head process on THIS machine while dispatching every task to Azure
    Batch. Deliberately NOT a profile in nextflow.config — pass it with `-c` so the blast
    radius is exactly the runs that opt in, and nothing else changes.

        nextflow run main.nf -profile ottilie_test_ci,docker -c conf/azure_batch.config

    WHY THIS EXISTS
    Seqera Platform injects its own azure.batch/azure.storage settings, so the repo has
    never had any. That makes a Platform launch the first time several things are exercised
    at once. This config isolates the Azure half:

      tested here   : pool creation via the Entra SP, input staging from blob, container
                      pulls on Batch nodes
      NOT in play   : cloning the repo from GitHub (runs your local working tree) and
                      Nextflow version pinning (you invoke the engine, so no Platform
                      default can override it)

    Once a run succeeds with this file, a Seqera launch adds only clone + version pinning,
    and any failure there is unambiguous.

    CREDENTIALS — from the environment, never from this file:
        export AZURE_CLIENT_ID=<sp app id>
        export AZURE_TENANT_ID=<tenant id>
        read -rs AZURE_CLIENT_SECRET && export AZURE_CLIENT_SECRET
    `read -rs` reads silently and keeps the secret out of shell history. The service
    principal needs `Azure Batch Data Contributor` on the batch account and
    `Storage Blob Data Contributor` on the storage account — see deploy/azure/.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// ⚠️ Groovy closure-scoping traps, all three verified — keep the `def`, keep `throw` (`exit`
// is unavailable here), and don't inspect this file with `nextflow config`. Explained in
// docs/dev-practices/troubleshooting.md → "Closures in a config file".
def req = { String name ->
    def v = System.getenv(name)
    if (!v) throw new IllegalStateException("conf/azure_batch.config: environment variable ${name} is not set — see the header of this file.")
    return v
}

azure {
    activeDirectory {
        servicePrincipalId     = req('AZURE_CLIENT_ID')
        servicePrincipalSecret = req('AZURE_CLIENT_SECRET')
        tenantId               = req('AZURE_TENANT_ID')
    }

    storage {
        accountName = System.getenv('AZURE_STORAGE_ACCOUNT') ?: 'aledata'
    }

    batch {
        accountName             = System.getenv('AZURE_BATCH_ACCOUNT') ?: 'aledev4test'
        location                = System.getenv('AZURE_BATCH_LOCATION') ?: 'northeurope'

        // Let Nextflow create its own pool. Keeps this run isolated from the six
        // pre-existing compute environments in the shared org workspace.
        autoPoolMode            = true
        allowPoolCreation       = true

        // Deleting the pool on completion BREAKS `-resume`. Nextflow derives the pool id
        // deterministically from the pool config, so a resumed run asks for the same id,
        // finds it mid-teardown, and fails every task with:
        //     Azure Batch pool 'nf-pool-<hash>-<vmtype>' not in active state
        //
        // Keeping the pool costs nothing while idle: autoscale drains it to 0 nodes and
        // you are billed for VMs, not for the pool object. So the debug-cycle default is
        // to keep it — resume works immediately and skips ~5 min of pool creation.
        //
        // Trade-off: pools accumulate and need occasional manual cleanup:
        //     az batch pool list --query "[?starts_with(id,'nf-pool')].id" -o tsv \
        //       | xargs -r -n1 az batch pool delete --yes --pool-id
        // For a one-shot production run, set AZURE_DELETE_POOLS=true.
        deletePoolsOnCompletion = (System.getenv('AZURE_DELETE_POOLS') ?: 'false') == 'true'

        pools {
            auto {
                // Ev4/Dv3 both have 350 dedicated vCPU quota here; families without quota
                // fail with AccountVMSeriesCoreQuotaReached. E4ds_v4 (4 vCPU / 32 GB) is
                // the size already proven in this account via the Seqera CE `ALE_E4ds_v4`,
                // and the extra RAM over D4s_v3 (16 GB) suits the GATK steps.
                vmType     = System.getenv('AZURE_VM_TYPE') ?: 'Standard_E4ds_v4'
                autoScale  = true
                vmCount    = 1
                maxVmCount = (System.getenv('AZURE_MAX_VMS') ?: '4') as int

                // Pool VM image — pin the newest ubuntu-hpc LTS that Batch marks "verified".
                //
                //   - `sku` is the NODE AGENT SKU ID, not the image sku. '2404' is silently
                //     ignored; only 'batch.node.ubuntu 24.04' works.
                //   - Nextflow accepts only "verified" images, and its default agent sku
                //     (22.04) has reached end of Batch node-agent support, so the default now
                //     matches nothing:
                //         Cannot find a matching VM image with publisher=microsoft-dsvm;
                //         offer=ubuntu-hpc; OS type=linux; verification type=verified
                //     This is Microsoft's image lifecycle, NOT an account setting — identical
                //     across four Batch accounts in two regions. Expect to bump at each LTS.
                //   - Stay on ubuntu-hpc: it is the only verified family with DockerCompatible.
                //     canonical/* and almalinux/* are verified but ship no container runtime,
                //     so they fail every TASK instead of failing pool creation.
                //
                // Re-check at the next LTS (or on any image-matching failure):
                //     az batch account login -g <rg> -n <account>
                //     az batch pool supported-images list -o json | \
                //       jq -r '.[] | select(.verificationType=="verified" and .osType=="linux")
                //              | "\(.imageReference.publisher) \(.imageReference.offer) \
                //                 \(.imageReference.sku) \(.nodeAgentSkuId) \(.capabilities)"'
                publisher  = 'microsoft-dsvm'
                offer      = 'ubuntu-hpc'
                sku        = 'batch.node.ubuntu 24.04'
            }
        }
    }
}

process {
    executor = 'azurebatch'
}

// Work dir MUST be on blob — Batch nodes cannot see this machine's filesystem.
//
// ⚠️ It must also live in the SAME CONTAINER as the pipeline inputs.
// With Entra/service-principal auth, Nextflow mints a CONTAINER-scoped user-delegation
// SAS (sr=c) for the work-dir container and hands that to the Batch nodes. A node has no
// credential for any other container, so inputs elsewhere fail at download time with:
//     Unable to download path: https://<account>.blob.core.windows.net/<other>/...
// and the task exits 1 with an empty stderr — the real message is only in .command.log.
//
// Inputs are under az://aletest/ottilie/v1/, so the work dir goes in `aletest` too.
// Same storage account either way, so the SP's Storage Blob Data Contributor still covers
// it and no extra grant is needed.
workDir = System.getenv('AZURE_WORK_DIR') ?: 'az://aletest/nf-work'
