/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SPLIT_JOINT_VCF — per-caller rules for splitting a joint (multi-sample) VCF per sample
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    One subworkflow, several callers: HaplotypeCaller (--split_haplotypecaller_joint_vcf) and
    Manta (--joint_manta). The pipeline invokes it under an alias per caller
    (SPLIT_JOINT_VCF, SPLIT_JOINT_VCF_MANTA, ...) while the unit test runs it under the bare
    name, so every rule is keyed on `meta.variantcaller`, never on the process name. Adding a
    caller = one more branch here (no subworkflow change).

    Two steps per sample:
      BCFTOOLS_VIEW    extract the sample column (kept patient-prefixed for traceability).
      BCFTOOLS_FILTER  keep only records this sample carries; index; publish.

    Why the callers differ:
      - HaplotypeCaller: the hom-ref genotype depends on ploidy ("0" haploid, "0/0" diploid), so
        the non-ref filter is built from meta.ploidy. GATK has no per-sample FORMAT/FT.
      - Manta: genotypes are always diploid-model (0/0, 0/1, 1/1) regardless of meta.ploidy, so a
        ploidy-derived pattern would keep every hom-ref row for haploids. Hom-ref/missing rows are
        dropped with `--min-ac 1:nref` (AC/AN are recomputed after -s; note `-i` is NOT — it is
        evaluated before subsetting). Manta's per-sample FORMAT/FT (MinGQ; HomRef is implied by
        0/0 and already dropped) is promoted into FILTER so a weak genotype is not read as PASS
        just because the cohort-level record is; the MinGQ header line comes from Manta itself.
----------------------------------------------------------------------------------------
*/

process {

    withName: '.*SPLIT_JOINT_VCF.*:BCFTOOLS_VIEW' {
        ext.args   = { meta.variantcaller == 'manta'
            ? "--samples ${meta.bcftools_sample} --force-samples --min-ac 1:nref -Oz"
            : "--samples ${meta.bcftools_sample} --force-samples -Oz" }
        ext.prefix = { meta.variantcaller == 'manta'
            ? "${meta.id}.manta.diploid_sv.raw"
            : "${meta.id}.haplotypecaller.from_joint_calling.raw" }
        publishDir = [
            enabled: false  // intermediate — only the filtered per-sample VCF is published
        ]
    }

    withName: '.*SPLIT_JOINT_VCF.*:BCFTOOLS_FILTER' {
        ext.args   = {
            if (meta.variantcaller == 'manta') {
                "--soft-filter MinGQ --mode + --exclude 'FMT/FT!=\"PASS\"' -Oz --write-index=tbi"
            } else {
                def ploidy = meta.ploidy ?: 2
                def ref_gt_unphased = (['0'] * ploidy).join('/')  // e.g. "0/0" for diploid
                def ref_gt_phased   = (['0'] * ploidy).join('|')  // e.g. "0|0" for diploid
                // GT is not missing AND not reference (phased or unphased)
                "--include 'GT!=\".\" && GT!=\"./\" && GT!=\".|\" && GT!=\"${ref_gt_unphased}\" && GT!=\"${ref_gt_phased}\"' -Oz --write-index=tbi"
            }
        }
        ext.prefix = { meta.variantcaller == 'manta'
            ? "${meta.id}.manta.diploid_sv"
            : "${meta.id}.haplotypecaller.from_joint_calling" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { meta.variantcaller == 'manta'
                ? "${params.outdir}/variant_calling/manta/${meta.id}/"
                : "${params.outdir}/variant_calling/haplotypecaller/individual_from_joint/${meta.id}/" },
            pattern: "*{vcf.gz,vcf.gz.tbi}"
        ]
    }
}
