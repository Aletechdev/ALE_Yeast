/*
 * Configuration for MUTATION_REPORT subworkflow processes.
 *
 * Controls publishDir, ext.args, and other process-specific settings
 * for CN/SV data generation and igv-reports dashboard.
 */

// Report output directory (separate from pipeline output)
def report_outdir = params.report_outdir ?: "${params.outdir}/mutation_reports"

process {
    // --- CN Matrix ---
    withName: 'BUILD_CN_MATRIX' {
        publishDir = [
            path: { "${report_outdir}/data/cn_matrices" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BUILD_CONTIG_CN' {
        publishDir = [
            path: { "${report_outdir}/data" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BUILD_CN_COHORT' {
        publishDir = [
            path: { "${report_outdir}/data" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BUILD_SV_MATRIX' {
        publishDir = [
            path: { "${report_outdir}/data" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --- SVDB SV merge chain (the SV cohort deliverable). Layers published for
    //     troubleshooting: merge inputs + across-samples VCFs under data/sv_merge_inputs/,
    //     the cross-caller cohort VCFs at their canonical data/sv_cohort_merged_<mode>
    //     names (load-bearing: generate_index.py probes them for the VCF download
    //     buttons). Recipe + flag rationale: 04_validate/sv_merge_bench/NOTES.md ---
    withName: 'MANTA_CONVERTINVERSION' {
        ext.prefix = { "${meta.id}.manta.inv" }
        publishDir = [enabled: false]   // intermediate; the collapsed merge input is published instead
    }

    withName: 'COLLAPSE_SV_PAIRS' {
        // Output name doubles as svdb's file-derived tag at the across-samples merge, so the
        // final merge-input names must be <id>.<caller>.vcf. TIDDIT gets a .collapsed infix
        // because TIDDIT_SV_FILTER still runs on it and claims the final name; its collapsed
        // intermediate is accordingly not published (the soft-filtered file is the merge input).
        ext.prefix = { meta.caller == 'tiddit' ? "${meta.id}.tiddit.collapsed" : "${meta.id}.${meta.caller}" }
        publishDir = [
            path: { "${report_outdir}/data/sv_merge_inputs" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') || meta.caller == 'tiddit' ? null : filename }
        ]
    }

    withName: 'TIDDIT_SV_FILTER' {
        // Item-4 soft filters (Manta-inspired named vetoes; see the module header and
        // docs/variant-calling/sv_merge.md). Tuning = edit these expressions; the tags are
        // soft (--mode +), so a change only moves records between the pass and union views.
        ext.lowqual    = 'QUAL<40'
        ext.lowsupport = 'MAX(FMT/DV+FMT/RV)<6'
        ext.highmq0    = 'MAX(FMT/LQ)>0.4'
        ext.prefix     = { "${meta.id}.tiddit" }
        publishDir = [
            path: { "${report_outdir}/data/sv_merge_inputs" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_SV_PASS' {
        ext.args   = '-f PASS,. -Ov'   // --apply-filters PASS or '.' — the TRUE pass view (bench F2)
        ext.prefix = { "${meta.id}.${meta.caller}.pass" }
        publishDir = [enabled: false]  // one bcftools command away from the published merge input
    }

    withName: 'SVDB_MERGE_MANTA|SVDB_MERGE_TIDDIT' {
        ext.args   = '--no_intra'
        ext.args2  = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}_${meta.merge_mode}" }   // sv_tiddit_cohort_union.vcf.gz etc.
        publishDir = [
            path: { "${report_outdir}/data/sv_merge_inputs" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CHECK_SV_SAMPLE_ORDER' {
        publishDir = [enabled: false]
    }

    withName: 'SVDB_MERGE_CALLERS' {
        // Frozen recipe (bench 2026-08-28): type-strict, no within-file clustering, explicit
        // bnd_distance (svdb default, SURVIVOR used 1000 — bench F8: results insensitive),
        // manta priority first (decision e33a4dd). --pass_only deliberately absent (F2).
        ext.args   = '--no_intra --same_order --bnd_distance 2000'
        ext.args2  = '--output-type z --write-index=tbi'
        ext.prefix = { "sv_cohort_merged_${meta.merge_mode}" }
        publishDir = [
            path: { "${report_outdir}/data" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --- GFF3 + VCF Preparation ---
    withName: 'PREPARE_GFF3' {
        publishDir = [enabled: false]
    }

    withName: 'PREPARE_VCF' {
        // Display-only intermediate (multi-allelic split, FILTER->INFO/VCF_FILTER, FORMAT/VAF) consumed
        // by the igv-reports processes and GENERATE_INDEX through channels. NOT published: the output
        // is named by meta.id only, and PREPARE_VCF runs once per caller per sample, so publishing let
        // four tasks (HC, CNVKit, Manta, TIDDIT) race for the same prepare/<sample>.prepared.vcf.gz -
        // whichever finished last won. The canonical per-caller VCFs are shipped under vcf/ instead.
        publishDir = [enabled: false]
    }

    // --- IGV Reports ---
    withName: 'IGVREPORTS_COHORT' {
        publishDir = [
            path: { "${report_outdir}" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'IGVREPORTS_SAMPLE' {
        publishDir = [
            path: { "${report_outdir}/samples" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'IGVREPORTS_SV_CNV' {
        publishDir = [
            path: { "${report_outdir}/samples" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CNR_TO_BEDGRAPH' {
        publishDir = [enabled: false]
    }

    // --- PASS Filtering (TIDDIT + Manta; stats TSVs feed the Sample Overview "PASS / all" counts) ---
    withName: 'FILTER_PASS_VCF' {
        publishDir = [
            path: { "${report_outdir}/data" },
            mode: params.publish_dir_mode ?: 'copy',
            pattern: '*.pass_stats.tsv'
        ]
    }

    // --- VCF Publishing ---
    withName: 'PUBLISH_VCFS' {
        publishDir = [
            path: { "${report_outdir}/vcf" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --- Index Dashboard ---
    withName: 'GENERATE_INDEX' {
        ext.python_bin = 'python'
        // Image tag comes from params.report_container (nextflow.config), read directly by the
        // module's container directive — no override needed here.
        publishDir = [
            path: { "${report_outdir}" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
