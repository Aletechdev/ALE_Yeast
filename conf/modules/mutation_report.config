/*
 * Configuration for MUTATION_REPORT subworkflow processes.
 *
 * Controls publishDir, ext.args, and other process-specific settings
 * for CN/SV data generation and igv-reports dashboard.
 */

// Report output directory (separate from pipeline output)
def report_outdir = params.report_outdir ?: "${params.outdir}/mutation_reports"

process {
    // --- CN Matrix ---
    withName: 'BUILD_CN_MATRIX' {
        publishDir = [
            path: { "${report_outdir}/data/cn_matrices" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BUILD_CN_COHORT' {
        publishDir = [
            path: { "${report_outdir}/data" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --- SV Merge (uses nf-core bcftools/view for PASS filtering + decompression) ---
    withName: 'FILTER_SV_VCF_MANTA|FILTER_SV_VCF_TIDDIT' {
        ext.args   = '-f PASS -Ov'   // PASS-filter, plain VCF output for SURVIVOR
        ext.prefix = { "${meta.id}.${meta.caller}.filtered" }
        publishDir = [enabled: false]
    }

    withName: 'DECOMPRESS_SV_MANTA|DECOMPRESS_SV_TIDDIT' {
        ext.args   = '-Ov'   // Decompress only (no filter), plain VCF for SURVIVOR
        ext.prefix = { "${meta.id}.${meta.caller}.decompressed" }
        publishDir = [enabled: false]
    }

    withName: 'SURVIVOR_SV_MERGE_PASS|SURVIVOR_SV_MERGE_UNION' {
        ext.min_callers = 1  // union mode
        publishDir = [enabled: false]  // plain VCF intermediate; compressed version published by BGZIPTABIX
    }

    withName: 'BGZIPTABIX_SV_PASS|BGZIPTABIX_SV_UNION' {
        ext.prefix = { "${meta.id}.survivor.${meta.merge_mode ?: 'union'}" }
        ext.args2  = '-p vcf'  // tabix preset for VCF indexing
        publishDir = [
            path: { "${report_outdir}/data/sv_merged/${meta.id}" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SURVIVOR_COHORT_MERGE_PASS|SURVIVOR_COHORT_MERGE_UNION' {
        publishDir = [enabled: false]  // intermediate for BUILD_SV_MATRIX
    }

    withName: 'BUILD_SV_MATRIX_PASS|BUILD_SV_MATRIX_UNION' {
        publishDir = [
            path: { "${report_outdir}/data" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --- GFF3 + VCF Preparation ---
    withName: 'PREPARE_GFF3' {
        publishDir = [enabled: false]
    }

    withName: 'PREPARE_VCF' {
        publishDir = [
            path: { "${report_outdir}/prepare" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --- IGV Reports ---
    withName: 'IGVREPORTS_COHORT' {
        publishDir = [
            path: { "${report_outdir}" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'IGVREPORTS_SAMPLE' {
        publishDir = [
            path: { "${report_outdir}/samples" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'IGVREPORTS_SV_CNV' {
        publishDir = [
            path: { "${report_outdir}/samples" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CNR_TO_BEDGRAPH' {
        publishDir = [enabled: false]
    }

    // --- PASS Filtering ---
    withName: 'FILTER_PASS_VCF' {
        publishDir = [
            path: { "${report_outdir}/data" },
            mode: params.publish_dir_mode ?: 'copy',
            pattern: '*.pass_stats.tsv'
        ]
    }

    // --- VCF Publishing ---
    withName: 'PUBLISH_VCFS' {
        publishDir = [
            path: { "${report_outdir}/vcf" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // --- Index Dashboard ---
    withName: 'GENERATE_INDEX' {
        ext.python_bin = 'python'
        // Image tag comes from params.report_container (nextflow.config), read directly by the
        // module's container directive — no override needed here.
        publishDir = [
            path: { "${report_outdir}" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
