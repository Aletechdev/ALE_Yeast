/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ALE overrides for Manta — kept out of the upstream manta.config (0-diff vs sarek)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    --manta_high_sensitivity turns off the two human-WGS heuristics that hide real junctions in
    yeast ALE strains (engineered multi-copy constructs, amplified regions, Ty/LTR insertions):
      - depth filters: Manta exposes them only through `--exome` ("set options for WES input: turn
        off depth filters" — that is the whole effect; it is not a data-type change, so `--wes`
        stays false for WGS and keeps its pipeline-wide meaning);
      - the breakend-hub edge cap: graphNodeMaxEdgeCount = 0 via assets/manta_high_sensitivity.ini,
        passed through the module's `config` input (see bam_variant_calling_germline_manta).
    Evidence and the per-record effect on the 4-sample pilot:
    docs/benchmarking/ottilie_xenobiotic_ale/04_validate/pilot_results_v2/NOTES.md.
    Included after manta.config so this ext.args wins for the same selector.
----------------------------------------------------------------------------------------
*/

process {
    if (params.tools && params.tools.split(',').contains('manta')) {
        withName: 'MANTA_GERMLINE|MANTA_TUMORONLY|MANTA_SOMATIC' {
            ext.args = { (params.wes || params.manta_high_sensitivity) ? "--exome" : '' }
        }
    }
}
