/*
 * yAMP preflight tasks — reference checks that need the files staged (docs/usage/preflight_checks.md).
 * The Groovy preflight (parameters, samplesheet) lives in subworkflows/local/utils_nfcore_sarek_pipeline
 * and runs at DAG build; the checks here read the reference files themselves, so they run as tasks.
 */

process {
    withName: 'PREFLIGHT_REFERENCE' {
        // Stop the run at once on a failed check. The base errorStrategy is `finish`, which would let
        // every already-submitted task run to completion first; the script exits 65, outside the base
        // retry range (130–145, 104), so no retry is attempted either.
        errorStrategy = 'terminate'
        // Forward the task's console lines: the verdicts with the [yAMP preflight] prefix (ERROR only today).
        // A clean reference prints nothing.
        debug        = true
        publishDir   = [
            path: { "${params.outdir}/reports/preflight" },
            mode: params.publish_dir_mode,
            pattern: '*_mqc.tsv'
        ]
    }
}
