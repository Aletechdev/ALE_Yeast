/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
        ext.when   = When to run the module.
----------------------------------------------------------------------------------------
*/

// TRIMMING

process {

    withName: 'FASTP' {
        ext.args   = [
            // Read preprocessing steps, each under its own parameter (docs/usage/read_preprocessing.md).
            // Step 1 keeps upstream sarek 3.5.1 semantics (`trim_fastq` is the deprecated alias of
            // `trim_adapter`). `trim_nextseq` 0 passes nothing, so fastp's read-name poly-G auto-detection
            // applies as in upstream.
            // -- step 1: adapter trimming
            !(params.trim_adapter || params.trim_fastq)                            ? '--disable_adapter_trimming'                           : '',
            (params.trim_adapter || params.trim_fastq) && params.adapter_sequence    ? "--adapter_sequence ${params.adapter_sequence}"       : '', // explicit R1 adapter (else --detect_adapter_for_pe, set by the module)
            (params.trim_adapter || params.trim_fastq) && params.adapter_sequence_r2 ? "--adapter_sequence_r2 ${params.adapter_sequence_r2}" : '', // explicit R2 adapter (else same as R1)
            params.trim_nextseq            ? '--trim_poly_g'                              : '', // poly-G tails: any non-zero value forces it; at 0 fastp still auto-enables it for NextSeq/NovaSeq read names (upstream)
            // -- step 2: quality trimming per read end (variable length); fixed-count clips below are the legacy alternative
            params.trim_quality_3prime     ? "--cut_${params.trim_quality_3prime}"                          : '', // tail = Trimmomatic TRAILING, right = SLIDINGWINDOW
            params.trim_quality_5prime     ? '--cut_front'                                                   : '', // = Trimmomatic LEADING
            (params.trim_quality_3prime || params.trim_quality_5prime) ? "--cut_window_size ${params.trim_quality_window} --cut_mean_quality ${params.trim_quality_mean}" : '',
            params.clip_r1 > 0             ? "--trim_front1 ${params.clip_r1}"            : '', // Remove bp from the 5' end of read 1
            params.clip_r2   > 0           ? "--trim_front2 ${params.clip_r2}"            : '', // Remove bp from the 5' end of read 2
            params.three_prime_clip_r1 > 0 ? "--trim_tail1 ${params.three_prime_clip_r1}" : '', // Remove bp from the 3' end of read 1 (fastp applies fixed clips BEFORE the quality cut - measured, see the audit doc)
            params.three_prime_clip_r2 > 0 ? "--trim_tail2 ${params.three_prime_clip_r2}" : '', // Remove bp from the 3' end of read 2 (same order)
            // -- step 3: read filtering, evaluated on the trimmed read
            params.filter_quality          ? "--qualified_quality_phred ${params.filter_quality_phred} --unqualified_percent_limit ${params.filter_quality_percent}" : '--disable_quality_filtering',
            params.length_required > 0     ? "--length_required ${params.length_required}": '', // Reads shorter will be discarded
            // -- parallelisation (not a preprocessing step)
            params.split_fastq > 0         ? "--split_by_lines ${params.split_fastq * 4}" : '', // Output by limiting lines of each file with this option
        ].join(' ').trim()
        publishDir = [
            [
                path: { "${params.outdir}/reports/fastp/${meta.sample}" },
                mode: params.publish_dir_mode,
                pattern: "*.{html,json,log}"
            ],
            [
                path: { "${params.outdir}/preprocessing/" },
                mode: params.publish_dir_mode,
                pattern: "*.fastp.fastq.gz",
                saveAs: { params.save_trimmed || params.save_split_fastqs ?  "fastp/${meta.sample}/${it}" : null }
            ]
        ]
    }
}
