/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for HaplotypeCaller individual VCF (from joint calling) hard filtering
    Applies sample-specific quality filters for MultiQC-compatible QC reporting
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // Hard filtering for individual VCFs from joint calling
    withName: '.*VCF_FILTER_HAPLOTYPECALLER_JOINT:BCFTOOLS_HARD_FILTER_JOINT' {
        ext.when = { meta.variantcaller == 'haplotypecaller' && meta.source == 'joint_calling' }

        // Sample-level quality filter parameters optimized for yeast ALE experiments
        // Designed to ensure per-sample quality (not cohort-wide)
        //
        // NOTE: Removes variants entirely (no --set-GTs) for clean MultiQC reporting
        // This ensures accurate variant counts across pipeline stages
        //
        // Key distinction:
        //   INFO/DP  = cohort-wide depth (all samples combined)
        //   FORMAT/DP = this specific sample's depth (what we filter on)
        //   FORMAT/GQ = genotype quality for this sample
        //   FORMAT/AD = allelic depths [REF,ALT] for this sample
        // Dynamic AF threshold: >=90% for clonal (near-fixed), >=5% for population (low-frequency)
        ext.args = {
            def af_threshold = (meta.clonal_or_population == 'population') ? 0.05 : 0.80
            [
                '--include',
                '"FILTER=\\"PASS\\"',              // Only variants that passed joint calling filters
                '& FORMAT/GQ>=20',                 // Genotype quality for THIS sample
                '& FORMAT/DP>=8',                  // Read depth for THIS sample (not cohort-wide)
                "& FORMAT/AD[0:1]/(FORMAT/AD[0:0]+FORMAT/AD[0:1])>=${af_threshold}\""  // ALT AF threshold
            ].join(' ')
        }

        ext.prefix = { "${meta.id}" }

        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling_filtered/haplotypecaller/individual_from_joint/${meta.sample}/" },
            pattern: "*.vcf.gz*"
        ]
    }
}
