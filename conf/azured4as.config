/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Local dev-VM resources profile — Azure D4as_v5 (4 vCPU, 16 GB RAM)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Loaded as the `azureD4as` profile (nextflow.config → includeConfig), so:
        nextflow run main.nf -profile ottilie_test,azureD4as,docker   (no -c needed)

    Overrides conf/base.config's Azure Batch E4ds_v5 sizing (28 GB) for this smaller local
    VM: caps the memory ceiling at 14 GB (16 GB - 2 GB headroom) and trims per-task requests
    to observed peaks so more tasks pack in. NOT for cloud/Seqera — cloud uses base.config +
    its compute environment. To port to another local VM, copy this file, change the two
    numbers (executor + resourceLimits), and add a profile line in nextflow.config.
    See docs/dev-practices/compute_resources.md
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Executor pool — gates how many tasks run concurrently (combined requests <= pool)
executor {
    name   = 'local'
    cpus   = 4
    memory = '14 GB'   // With 8 GB swap available. Allows 3 concurrent tasks at 4 GB each.
}

process {
    memory        = '4 GB'   // Default for most tasks (<2 GB actual: HaplotypeCaller 1.4 GB, CNVKit 644 MB, TIDDIT 1.5 GB, FREEC 29 MB)
    cpus          = 2
    time          = '24h'    // Default time limit: 24 hours
    errorStrategy = 'retry'
    maxRetries    = 1

    // Clamp: no single task may REQUEST more than this (so it always fits the pool)
    resourceLimits {
        cpus   = 4
        memory = '14 GB'
        time   = '72h'       // Maximum time limit: 72 hours
    }
    containerOptions = '--platform linux/amd64'

    // Override label-based memory and time from base.config (which targets a 32 GB node).
    // Without these, base.config labels (process_low=12GB, process_medium=16GB) would be
    // clamped to 14 GB and run mostly serially — these trim to actual peaks for throughput.
    withLabel: 'process_single' {
        memory = '4 GB'
    }
    withLabel: 'process_low' {
        memory = '4 GB'   // base.config: 12 GB; actual peak: FREEC 29 MB, CNVKit 644 MB, TIDDIT 1.5 GB
    }
    withLabel: 'process_medium' {
        memory = '4 GB'   // base.config: 16 GB; actual peak: HaplotypeCaller 1.4 GB, SnpEff ~850 MB
        time   = '24h'    // Override default 8h limit from base.config
    }
    withLabel: 'process_high' {
        memory = '6 GB'   // base.config: 28 GB; actual peak: BWA-MEM 5.0 GB
        time   = '48h'    // Override default 16h limit from base.config
    }

    // Memory-hungry processes (peak RSS from Tier 2 trace, 86 samples)
    withName: 'GATK4_MARKDUPLICATES' {
        memory = '8 GB'  // Peak: 7.1 GB
    }
    withName: 'BWAMEM1_MEM' {
        cpus   = 4
        memory = '6 GB'  // Peak: 5.0 GB
    }
    withLabel: 'bwa_mem' {
        cpus   = 4
        memory = '6 GB'
    }
    withName: 'GATK4_CREATESEQUENCEDICTIONARY' {
        cpus   = 2
        memory = '12 GB'
    }
    withName: 'MUTECT2*' {
        cpus   = 4
        memory = '14 GB'
        time   = '48h'  // Extended time for Mutect2: 48 hours (overrides process_medium)
    }
    // Joint calling — scales with sample count (763 MB for 4 samples, ~16 GB estimated for 86)
    withName: 'GATK4_GENOMICSDBIMPORT|GATK4_GENOTYPEGVCFS' {
        memory = '12 GB'  // Swap provides additional 8 GB safety net
    }
}
