/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/sarek Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Right-sized for Azure Batch E4ds_v5 (4 vCPU, 32 GB).
    Seqera Batch Forge uses a single VM type per pool — all tasks run on E4ds_v5.
    Local runs override via -profile azureD4as,docker (conf/azured4as.config resourceLimits).
----------------------------------------------------------------------------------------
*/

process {

    // Resource limits for Azure Batch E4ds_v5 (4 vCPU, 32 GB)
    resourceLimits {
        cpus   = 4
        memory = 28.GB    // 32 GB VM - 4 GB OS/agent headroom
        time   = 72.h
    }

    // Global defaults
    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    // Retries for transient Azure failures (preemption, network), not OOM
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // Error handling labels
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    // Label-based resource groups — differentiated for E4ds_v5
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 4     * task.attempt }   // was 6, cap to VM max
        memory = { 16.GB * task.attempt }   // was 36 GB, moderate tasks
        time   = { 24.h  * task.attempt }   // was 8h, batch overhead
    }
    withLabel:process_high {
        cpus   = { 4     * task.attempt }   // was 12, cap to VM max
        memory = { 28.GB * task.attempt }   // was 72 GB, full VM for breseq/heavy callers
        time   = { 48.h  * task.attempt }   // was 16h, batch overhead
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }

    // Process-specific overrides
    withName: 'UNZIP.*|UNTAR.*|TABIX.*|BUILD_INTERVALS|CREATE_INTERVALS_BED|VCFTOOLS|BCFTOOLS.*|SAMTOOLS_INDEX' {
        cpus   = { 1    * task.attempt }
        memory = { 1.GB * task.attempt }
    }
    withName: 'FASTQC'{
        cpus   = { 4    * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withName: 'FASTP'{
        cpus   = { 4    * task.attempt }   // was 12, cap to VM max
        memory = { 4.GB * task.attempt }
    }
    withName: 'BWAMEM1_MEM|BWAMEM2_MEM' {
        cpus   = { 4     * task.attempt }   // was 24, cap to VM max
        memory = { 12.GB * task.attempt }   // yeast index < 4 GB; 12 GB covers sorting overhead
    }
    withName:'CNVKIT_BATCH' {
        label  = "process_high"
        memory = { 28.GB * task.attempt }
    }
    withName: 'GATK4_MARKDUPLICATES|GATK4SPARK_MARKDUPLICATES' {
        cpus   = { 4     * task.attempt }   // was 6, cap to VM max
        memory = { 16.GB * task.attempt }   // was 30 GB
    }
    withName:'GATK4_APPLYBQSR|GATK4SPARK_APPLYBQSR|GATK4_BASERECALIBRATOR|GATK4SPARK_BASERECALIBRATOR|GATK4_GATHERBQSRREPORTS'{
        cpus   = { 2    * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withName:'MOSDEPTH'{
        cpus   = { 4    * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withName:'STRELKA.*|MANTA.*' {
        cpus   = { 4    * task.attempt }   // was 10, cap to VM max
        memory = { 8.GB * task.attempt }
    }
    withName:'SAMTOOLS_CONVERT'{
        memory = { 4.GB * task.attempt }
    }
    withName:'GATK4_MERGEVCFS'{
        cpus   = { 2    * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withName: 'MUTECT2*' {
        cpus   = 4
        memory = 12.GB
        time   = '48h'
    }
    withName: 'GATK4_CREATESEQUENCEDICTIONARY' {
        cpus   = 2
        memory = { 12.GB * task.attempt }
    }
    withName: 'MULTIQC' {
        cpus   = { 4     * task.attempt }
        memory = { 12.GB * task.attempt }
    }
}
