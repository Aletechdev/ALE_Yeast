/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Seqera Platform config for Azure Batch - ALE Yeast Pipeline
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    - No process.executor: Seqera injects this from the compute environment
    - No azure.storage/batch blocks: Seqera manages credentials
    - Resource limits tuned for yeast genome (~12 MB, much smaller than human ~3 GB)

    Usage in Seqera Platform:
      Config profiles: docker
      Nextflow config: paste this file content or reference conf/seqera_azure.config
      Parameters: upload conf/params_seqera_test.yml
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // Cap all process resource requests to fit single auto-pool VM
    // Standard_D4s_v3 / D4as_v4: 4 vCPU, 16 GB (~$0.19/hr)
    // Sized for heaviest task: BWAMEM1_MEM (observed 4 vCPU, 4.8 GB on yeast genome)
    resourceLimits {
        cpus   = 4
        memory = 14.GB
        time   = 72.h
    }

    // Retry on transient Azure Batch failures (node preemption, spot eviction)
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    // Time overrides (base.config defaults are too short for batch scheduling overhead)
    withLabel: 'process_medium' {
        time = '24h'
    }
    withLabel: 'process_high' {
        time = '48h'
    }

    // Process-specific overrides for yeast genome
    withName: 'MUTECT2*' {
        cpus   = 4
        memory = 12.GB
        time   = '48h'
    }
    withName: 'GATK4_CREATESEQUENCEDICTIONARY' {
        cpus   = 2
        memory = { 12.GB * task.attempt }
    }
}

// Docker is required for Azure Batch
docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}
