/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Seqera Platform config — supplements base.config for Azure Batch
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Optional: paste into Seqera "Nextflow config file" field if docker profile
    isn't sufficient. Resource limits and process overrides are now in base.config
    (right-sized for E4ds_v5), so this file only handles two things:
      1. Disable nf-core institutional config fetch (configs/ dir not in this repo)
      2. Docker safety net (redundant if Seqera launches with -profile docker)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Disable nf-core institutional config fetch — configs/ dir not present in this repo
// 3.5.1 defaults custom_config_base to ${projectDir}/../configs/ (local path, doesn't exist on cloud)
params.custom_config_base = null

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}
