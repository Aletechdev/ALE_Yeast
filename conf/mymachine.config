/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TEMPLATE — fit this pipeline to YOUR machine
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Copy this file, edit the two numbers below, and pass it with -c:

        nextflow -c conf/mymachine.config run main.nf -profile ottilie_test,docker \
            --outdir ./output_ottilie_test --generate_reports

    This is a `-c` file, NOT a profile — it is deliberately not registered in
    nextflow.config's profiles {} block, so it never loads unless you ask for it.

    WHY THIS EXISTS
        conf/base.config sizes every task for the cloud target (Azure Batch E4ds_v5,
        4 vCPU / 32 GB). On a machine with less RAM, tasks would REQUEST more than
        exists and never get scheduled. `resourceLimits` is a clamp applied AFTER every
        other mechanism — including the retry escalation `{ 16.GB * task.attempt }` — so
        it caps requests no matter where they came from. That makes it the one setting
        you must get right; everything else is optional tuning.

    DO NOT use `-profile azureD4as` on another machine: that profile hard-codes this
    dev VM's ceilings (16 GB / 4 vCPU) and its per-task tuning.

    Full precedence rules, the porting table, and the cloud story:
        docs/dev-practices/compute_resources.md
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // ▼▼▼ EDIT THESE ▼▼▼
    //   cpus   = your vCPU count
    //   memory = physical RAM minus ~2 GB headroom
    // The values below are this repo's validated floor (the ottilie test set runs
    // comfortably in them; measured peaks are all < 8 GB). Raise them to your machine.
    resourceLimits = [
        cpus  : 4,
        memory: '14.GB',
        time  : '72.h'
    ]
    // ▲▲▲ EDIT THESE ▲▲▲
}

/*
    OPTIONAL — an executor pool.

    Leave this commented out unless you have a reason. With no `executor` block,
    Nextflow's local executor auto-detects the host's CPUs/RAM and sizes concurrency
    itself, which is what you want on an unfamiliar machine.

    If you DO set one, keep  executor.memory / process.memory >= 2  so at least two
    tasks fit at once. A pool only slightly larger than a single task's request fits
    exactly one task and can DEADLOCK the local scheduler ("No more task to compute").
    Symptoms and diagnosis: docs/usage/nextflow_local_executor_deadlock.md

    executor {
        name   = 'local'
        cpus   = 4
        memory = '14.GB'
    }
*/

/*
    OPTIONAL — per-task tuning (throughput only, never correctness).

    base.config asks for cloud-sized memory per label; trimming those to the peaks you
    actually observe lets more tasks pack in. Measure first, from
    <outdir>/pipeline_info/execution_report_*.html → peak_rss. conf/azured4as.config is
    a worked example of this for the 16 GB dev VM — copy from there rather than guessing.

    process {
        withLabel: 'process_medium' { memory = '4.GB' }
        withLabel: 'process_high'   { memory = '6.GB' }
        withName:  'GATK4_MARKDUPLICATES' { memory = '8.GB' }
    }
*/

/*
    DO NOT put params (input, tools, fasta, outdir, …) in this file.
    `-c` outranks `-profile`, so any params here would silently override the settings
    that -profile ottilie_test (or your own profile) provides. Pass params on the
    command line instead.
*/
