/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Resource limits for LOCAL nf-test runs of the ottilie profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Loaded by tests/nf-test-ottilie.config as its `configFile`. Sets ONLY resourceLimits
    (no params), so it caps resources for the dev VM (4 vCPU / ~14 GB) WITHOUT clobbering
    the ottilie_test profile's input/tools (which a params-bearing -c config would — see
    the WP3 config-precedence probe). Mirrors the resourceLimits (clamp) role of the
    conf/azured4as.config azureD4as profile, without pulling in that profile's executor
    pool or per-task tuning. See docs/dev-practices/compute_resources.md § "nf-test resources".
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '14.GB',
        time: '24.h'
    ]
}
