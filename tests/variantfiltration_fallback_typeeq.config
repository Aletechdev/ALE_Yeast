// Used by ONE case of tests/variantfiltration_fallback.nf.test (the negative control): the SNP and
// INDEL filters with the type gate in the unquoted spelling TYPE == SNP / TYPE == INDEL, which GATK
// accepts and never matches (conf/modules/joint_germline.config, NOTE above ext.args; SNP is an
// undefined JEXL variable). The case asserts that every record then reads PASS, so the main case's
// sensitivity to that regression is measured rather than assumed. The QUOTED form TYPE == 'SNP' is
// not a failure: GATK 4.5.0.0 resolves it (measured 2026-10-19). Nothing in the pipeline uses this file.
process {
    withName: 'GATK4_VARIANTFILTRATION' {
        ext.args = { [
            '--filter-name "QD_filter" --filter "QD < 2.0"',
            '--filter-name "QUAL_filter" --filter "QUAL < 30.0"',
            '--filter-name "FS_filter" --filter "TYPE == SNP && FS > 60.0"',
            '--filter-name "SOR_FS_filter" --filter "TYPE == SNP && SOR > 3.0 && FS > 0.0"',
            '--filter-name "MQ_filter" --filter "TYPE == SNP && MQ < 40.0"',
            '--filter-name "MQRankSum_filter" --filter "TYPE == SNP && MQRankSum < -12.5"',
            '--filter-name "ReadPosRankSum_filter" --filter "TYPE == SNP && ReadPosRankSum < -8.0"',
            '--filter-name "FS_INDEL_filter" --filter "TYPE == INDEL && FS > 200.0"',
            '--filter-name "ReadPosRankSum_INDEL_filter" --filter "TYPE == INDEL && ReadPosRankSum < -20.0"'
        ].join(' ') }
    }
}
