// Used by ONE case of tests/joint_calling_output_selection.nf.test ("neither"): switches the
// soft-filter step off so the subworkflow's output selection can be observed with no fallback VCF.
// Nothing in the pipeline ever sets this; VARIANTFILTRATION_FALLBACK is unconditional there.
//
// Selector: path-qualified, with NO leading colon (the same trap conf/modules/split_joint_vcf.config
// hit). In nf-test's unit isolation the process is named
// BAM_JOINT_CALLING_GERMLINE_GATK:VARIANTFILTRATION_FALLBACK, nothing in front of it, so the form
// '.*:BAM_JOINT_...' never matches there (measured 2026-10-16: the task still launched); '.*BAM_JOINT_...'
// matches both that name and the pipeline's NFCORE_SAREK:SAREK:...:BAM_JOINT_...:VARIANTFILTRATION_FALLBACK.
// The test asserts that no fallback task launched, which is how a selector that silently fails to
// match is caught.
process {
    withName: '.*BAM_JOINT_CALLING_GERMLINE_GATK:VARIANTFILTRATION_FALLBACK' {
        ext.when = false
    }
}
