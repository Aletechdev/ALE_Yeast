/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Dedicated nf-test config for the ALE (ottilie) test suite
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Usage (from repo root):
        nf-test test -c tests/nf-test-ottilie.config tests/ottilie_e2e.nf.test

    Why a SEPARATE nf-test config (not the default nf-test.config):
      - The default nf-test.config force-loads `configFile "conf/test.config"` (upstream sarek
        test data: input/genome/tools=strelka) as a -c config. A -c config OUTRANKS profiles, so
        it would clobber the ottilie_test profile's input/tools (verified 2026-07-13). Here we point
        configFile at a resourceLimits-only config that sets NO params → no clobbering.
      - profile "ottilie_test,docker" activates the ALE test dataset + container engine. No azureD4as
        needed (resourceLimits come from ottilie_nftest_resources.config).
    The default nf-test.config is left untouched for the 119 upstream sarek tests.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

config {
    // Scope discovery to tests/ (avoids the modules/nf-core + .claude/worktrees test pollution)
    testsDir "tests"

    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"

    // resourceLimits ONLY (no params) — does not clobber the ottilie_test profile
    configFile "tests/ottilie_nftest_resources.config"

    // ALE test dataset + docker; resourceLimits from the configFile above
    profile "ottilie_test,docker"

    plugins {
        load "nft-bam@0.4.0"
        load "nft-utils@0.0.3"
    }
}
