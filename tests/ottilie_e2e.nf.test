nextflow_pipeline {

    name "Ottilie ALE end-to-end"
    script "../main.nf"
    tag "ottilie"
    tag "pipeline"

    // Run with:  nf-test test -c tests/nf-test-ottilie.config tests/ottilie_e2e.nf.test
    // Profile (ottilie_test,docker) + resourceLimits come from tests/nf-test-ottilie.config.
    // Tools exercised (from ottilie_test.config): snpeff, cnvkit, tiddit, manta, haplotypecaller
    //   + FASTP with the default read-preprocessing recipe (trim_adapter, trim_quality_3prime tail;
    //     snapshot re-recorded 2026-09-04 when it became the default).
    //   + joint germline, split joint VCF, and the MUTATION_REPORT dashboard. The per-sample hard
    //     filter (--hard_filter_haplotypecaller_joint) is NOT exercised: it left the ottilie recipe
    //     on 2026-09-08 (snapshot re-recorded then — the hard_filtered.* family vanished).
    //
    // This is the ALE end-to-end contract test: a clean single run with inline --generate_reports
    // must complete and produce the CN/SV cohort deliverables.
    //
    // Snapshot layers:
    //   stable_name  — every output file/dir NAME (the tree).
    //   stable_path  — CONTENT (md5) of every deterministic file, with the non-deterministic ones
    //                  excluded via tests/.nftignore (igv-reports HTML sessionDictionary + all
    //                  bgzipped VCFs/indexes vary run-to-run). Auto-covers the CN/SV cohort CSVs,
    //                  the cn_matrices CSVs, the tiddit stats TSVs, README, etc.
    //   report_tablejson — the deterministic variant-table blob inside each igv-report HTML
    //                  (the HTML file itself is .nftignore-excluded); hashed since blobs reach ~160 KB.
    //   hc_cohort_vcf — the joint/cohort HaplotypeCaller VCF records (## headers stripped: they carry a
    //                  wall-clock GATK timestamp), hashed. The complete SNV/INDEL superset.
    // Determinism of every hashed/snapshotted item verified across two independent runs.

    test("ottilie 2-sample: full ALE workflow + mutation report") {

        when {
            params {
                outdir           = "$outputDir"
                generate_reports = true   // opt-in: run the MUTATION_REPORT subworkflow
            }
        }

        then {
            // stable_name: every output file/dir NAME (the tree). pipeline_info excluded (timestamped names).
            def stable_name = getAllFilesFromDir(
                params.outdir,
                relative: true,
                includeDir: true,
                ignore: ['pipeline_info/**']
            )

            // stable_path: md5 CONTENT of every deterministic file; the non-deterministic ones are excluded
            // via tests/.nftignore. Auto-covers the CN/SV cohort CSVs, the cn_matrices CSVs, the tiddit
            // stats TSVs, README, etc. (mirrors default.nf.test).
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')

            // report_tablejson: the deterministic variant-table blob inside each igv-report HTML (the HTML
            // file itself is .nftignore-excluded — sessionDictionary is non-deterministic). Blobs reach
            // ~160 KB, so md5 them (no plugin parses HTML). Keyed by report → readable diff on failure.
            def reports   = "$outputDir/mutation_reports"
            def md5       = { s -> java.security.MessageDigest.getInstance('MD5').digest(s.toString().bytes).encodeHex().toString() }
            def tableJson = { rel -> md5(path("$reports/$rel").readLines().find { it.trim().startsWith('const tableJson') } ?: '') }
            def report_tablejson = [
                'cohort_report.html',
                'samples/CBR110-15-R3a_cnvkit_report.html',
                'samples/CBR110-15-R3a_hc_report.html',
                'samples/CBR110-15-R3a_manta_report.html',
                'samples/CBR110-15-R3a_tiddit_report.html',
                'samples/NODRUG-GM2_cnvkit_report.html',
                'samples/NODRUG-GM2_hc_report.html',
                'samples/NODRUG-GM2_manta_report.html',
                'samples/NODRUG-GM2_tiddit_report.html',
            ].collectEntries { [(it): tableJson(it)] }

            // hc_cohort_vcf: the joint/cohort HaplotypeCaller VCF — complete SNV/INDEL superset (all sites,
            // both sample GTs, full FILTER incl. the soft-filter contract). vcf.variantsMD5 (nft-vcf) hashes
            // the records and ignores the timestamped ## header. This report-bundle copy also implicitly
            // validates the PUBLISH_VCFS rename/curate step.
            def hc_cohort_vcf = path("$reports/vcf/haplotypecaller/cohort_haplotypecaller_annotated.vcf.gz").vcf.variantsMD5

            // Post-trim FastQC (2026-09-23): MultiQC must render FastQC twice — raw reads, then the fastp
            // output — with fastp between them, and the two passes must share General Stats ROWS (the
            // `_trimmed` clean rule in assets/multiqc_config.yml), not add rows. The general-stats
            // table is .nftignore-excluded from the content snapshot, so it is asserted explicitly here.
            // Section headings are matched on their `<h2 … id="…">`, never on the CSS class — 1.25.1
            // wrote class="mqc-module-title", 1.35 writes class="mb-0"; the ids are the stable contract.
            def mqc_data     = "$outputDir/multiqc/multiqc_data"
            def sections_of  = { html -> path(html).readLines()
                                   .findAll { it =~ /<h2[^>]*\sid="/ }
                                   .collect { (it =~ /id="([^"]+)"/)[0][1] } }
            def mqc_sections = sections_of("$outputDir/multiqc/multiqc_report.html")

            // Three MultiQC reports (2026-09-29): read-QC and alignment-QC, published while the run is
            // still calling, and complete-QC (the plain-named report above) at the end. Each opens with
            // the "yAMP input checks" table — the DAG-build checks' rows merged with the reference
            // check's — and ends with the Workflow Summary, collapsed.
            def read_qc      = sections_of("$outputDir/multiqc/yAMP-read-QC_multiqc_report.html")
            def alignment_qc = sections_of("$outputDir/multiqc/yAMP-alignment-QC_multiqc_report.html")
            def input_checks = path("$mqc_data/multiqc_yamp_input_checks_table.txt").readLines().drop(1).collect { it.split('\t') }
            def summary_id   = 'Aletechdev-ALE_Yeast-summary'
            def fastqc_samples = { pass -> path("$mqc_data/multiqc_fastqc_fastqc_${pass}.txt").readLines().drop(1).collect { it.split('\t')[0] }.sort() }
            def gs_rows   = path("$mqc_data/multiqc_general_stats.txt").readLines().collect { it.split('\t', -1) }
            def gs_col    = { name -> gs_rows[0].findIndexOf { it == name } }
            def rows_with = { col -> gs_rows.drop(1).findAll { it[col] != '' }.collect { it[0] } }
            def raw_total  = gs_col('fastqc_raw-total_sequences')
            def trim_total = gs_col('fastqc_after_preprocessing-total_sequences')

            assertAll(
                { assert workflow.success },

                // Two FastQC sections in the report, fastp between them (section ids measured on MultiQC 1.25.1 and 1.35)
                { assert mqc_sections.indexOf('fastqc_raw') >= 0 },
                { assert mqc_sections.indexOf('fastqc_raw') < mqc_sections.indexOf('fastp') },
                { assert mqc_sections.indexOf('fastp') < mqc_sections.indexOf('fastqc_trimmed') },
                // The trimmed pass parsed the same four sample names as the raw one (suffix stripped) ...
                { assert fastqc_samples('raw') == ['CBR110-15-R3a-L001_1', 'CBR110-15-R3a-L001_2', 'NODRUG-GM2-L001_1', 'NODRUG-GM2-L001_2'] },
                { assert fastqc_samples('trimmed') == fastqc_samples('raw') },
                // ... so both column groups exist and sit on exactly the same General Stats rows: the
                // lane-merge rules (table_sample_merge) give a sample row plus a Read1/Read2 row per sample
                { assert raw_total >= 0 && trim_total >= 0 },
                { assert rows_with(trim_total) == rows_with(raw_total) },
                { assert rows_with(raw_total) == ['CBR110-15-R3a', 'CBR110-15-R3a .Lane 1 Read1', 'CBR110-15-R3a .Lane 1 Read2',
                                                  'NODRUG-GM2',    'NODRUG-GM2 .Lane 1 Read1',    'NODRUG-GM2 .Lane 1 Read2'] },
                // and fastp's read filter is visible: trimmed read counts never exceed raw
                { assert gs_rows.drop(1).findAll { it[raw_total] != '' }.every { (it[trim_total] as double) <= (it[raw_total] as double) } },

                // The three MultiQC reports: input checks first, summary last, each stage a superset of the one before
                { assert [read_qc, alignment_qc, mqc_sections].every { it.first() == 'yamp_input_checks' && it.last() == summary_id } },
                { assert read_qc.containsAll(['fastqc_raw', 'fastp', 'fastqc_trimmed']) && !read_qc.contains('samtools') },
                { assert alignment_qc.containsAll(read_qc) && alignment_qc.containsAll(['picard', 'samtools', 'mosdepth']) && !alignment_qc.contains('bcftools') },
                { assert mqc_sections.containsAll(alignment_qc) && mqc_sections.containsAll(['bcftools', 'snpeff']) },
                { assert path("$outputDir/multiqc/multiqc_report.html").text.contains('<details><summary>Show the') },
                // one input-checks table: the reference check's row + the DAG-build checks' rows, all OK on the Tier-1 recipe
                { assert input_checks.collect { it[0] } == ['FASTA vs GFF3 contig names', 'Parameters: Tier-1 recipe',
                                                           'Samplesheet: experiment ids', 'Samplesheet: input files listed once',
                                                           'Samplesheet: ploidy and clonal flag per experiment'] },
                { assert input_checks.every { it[1] == 'OK' } },

                // Regression on task count + the software-versions manifest (Nextflow version stripped so
                // the snapshot is portable across Nextflow releases), plus the content layers above.
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_sarek_software_mqc_versions.yml"),
                    stable_name,
                    stable_path,
                    report_tablejson,
                    hc_cohort_vcf
                ).match() }
            )
        }
    }
}
