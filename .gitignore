**/work_*/

# Quality control - ignore data, output, and comparison folders
quality_control/*/data/
quality_control/*/output/
quality_control/*/comparison/

# Keep QC scripts, READMEs, and result summaries
!quality_control/**/*.py
!quality_control/**/*.R
!quality_control/**/*.sh
!quality_control/**/README.md
bin/multiqc/
