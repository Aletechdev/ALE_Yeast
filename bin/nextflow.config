process {
  // default memory for all processes
  memory = '12 GB'
  cpus = 6
  resourceLimits {
    cpus = 8
    memory = '14 GB'
  }

  // override specific process by name
  withName: 'GATK4_CREATESEQUENCEDICTIONARY' {
    memory = '12 GB'
  }
  // Add this block for MUTECT2
  withName: 'MUTECT2' {
    cpus = 8  // or however many you want
    memory = '14 GB'  // optional, if you want to adjust memory too
  }
  withName: 'BWAMEM1_MEM' {
    cpus = 8
  }
  withLabel: 'bwa_mem' {
    cpus = 8
  }
}
