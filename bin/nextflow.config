profiles {
  azureD4as {
    // Executor configuration
    executor {
      name = 'local'
      cpus = 4
      memory = '14 GB'
    }

    process {
      memory = '8 GB'
      cpus = 2
      time = '24h'  // Default time limit: 24 hours
      errorStrategy = 'retry'
      maxRetries = 1

      resourceLimits {
        cpus = 4
        memory = '14 GB'
        time = '72h'  // Maximum time limit: 72 hours
      }
      containerOptions = '--platform linux/amd64'

      // Override label-based time limits from base.config
      withLabel: 'process_medium' {
        time = '24h'  // Override default 8h limit from base.config
      }
      withLabel: 'process_high' {
        time = '48h'  // Override default 16h limit from base.config
      }

      // override specific process by name for D4as_v5 VM
      withName: 'GATK4_CREATESEQUENCEDICTIONARY' {
        cpus = 2
        memory = '12 GB'
      }
      withName: 'MUTECT2*' {
        cpus = 4
        memory = '14 GB'
        time = '48h'  // Extended time for Mutect2: 48 hours (overrides process_medium)
      }
      withName: 'BWAMEM1_MEM' {
        cpus = 4
      }
      withLabel: 'bwa_mem' {
        cpus = 4
      }
    }
  }

  test_ALE_Yeast {
    // Test profile for ALE yeast experiments
    // Use with: -profile azureD4as,test_ALE_Yeast,docker
    // Resources inherited from azureD4as, this profile sets test-specific parameters
    // IMPORTANT: Must run from repo root with: cd /path/to/ALE_nextflow && sh bin/test.sh

    params {
      // Test dataset paths (relative to repo root where you run the command)
      input         = "assets/reads/samplesheet.csv"
      outdir        = "test_output"

      // Reference genome
      genome        = null
      igenomes_ignore = true
      fasta         = "assets/references/draft_ref52.fasta"

      // Variant calling options
      joint_germline = true
      joint_mutect2  = true
      split_haplotypecaller_joint_vcf = true
      
      // Tools configuration
      tools         = 'snpeff,freebayes,mutect2,haplotypecaller'
      skip_tools    = 'baserecalibrator'
      split_fastq   = 0

      // Annotation
      snpeff_cache  = "assets/references/snpeff_cache"
      snpeff_db     = 'draft_ref.52'
    }
  }
}

// Default process settings - commented out to avoid profile conflicts
