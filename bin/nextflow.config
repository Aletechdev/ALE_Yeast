process {
  memory = '12 GB'
  cpus = 6
  resourceLimits {
    cpus = 8
    memory = '14 GB'
  }
  containerOptions = '--platform linux/amd64'

  // override specific process by name
  withName: 'GATK4_CREATESEQUENCEDICTIONARY' {
    memory = '12 GB'
  }
  withName: 'MUTECT2' {
    cpus = 8
    memory = '14 GB'
  }
  withName: 'BWAMEM1_MEM' {
    cpus = 8
  }
  withLabel: 'bwa_mem' {
    cpus = 8
  }
}
