profiles {
  azureD4as {
    // Executor configuration
    executor {
      name = 'local'
      cpus = 4
      memory = '14 GB'
    }

    process {
      memory = '8 GB'
      cpus = 2
      time = '24h'  // Default time limit: 24 hours
      errorStrategy = 'retry'
      maxRetries = 1

      resourceLimits {
        cpus = 4
        memory = '14 GB'
        time = '72h'  // Maximum time limit: 72 hours
      }
      containerOptions = '--platform linux/amd64'

      // Override label-based time limits from base.config
      withLabel: 'process_medium' {
        time = '24h'  // Override default 8h limit from base.config
      }
      withLabel: 'process_high' {
        time = '48h'  // Override default 16h limit from base.config
      }

      // override specific process by name for D4as_v5 VM
      withName: 'GATK4_CREATESEQUENCEDICTIONARY' {
        cpus = 2
        memory = '12 GB'
      }
      withName: 'MUTECT2*' {
        cpus = 4
        memory = '14 GB'
        time = '48h'  // Extended time for Mutect2: 48 hours (overrides process_medium)
      }
      withName: 'BWAMEM1_MEM' {
        cpus = 4
      }
      withLabel: 'bwa_mem' {
        cpus = 4
      }
    }
  }
}

// Default process settings - commented out to avoid profile conflicts
