/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for FreeBayes filtering modules
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // Basic quality filtering for FreeBayes variants
    withName: 'VCF_FILTER_FREEBAYES:BCFTOOLS_FILTER' {
        ext.args = [
            '--include "QUAL>=20"',                    // Minimum variant quality score
            '--include "INFO/DP>=10"',                 // Minimum total depth
            '--include "INFO/AF>=0.05"',               // Minimum allele frequency
            '--include "TYPE=\\"snp\\" || TYPE=\\"indel\\""', // Only SNPs and indels
            '--exclude "INFO/AF=1 && INFO/AO<3"'       // Exclude likely false positives
        ].join(' && ')
        
        ext.prefix = { "${meta.id}.quality_filtered" }
        
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling_filtered/freebayes/${meta.id}/" },
            pattern: "*.vcf.gz"
        ]
    }
    
    // High-impact variant filtering
    withName: 'VCF_FILTER_FREEBAYES:BCFTOOLS_FILTER_HIGH_IMPACT' {
        ext.args = [
            '--include "QUAL>=30"',                    // Higher quality threshold
            '--include "INFO/DP>=15"',                 // Higher depth requirement
            '--include "INFO/AF>=0.1"',                // Higher allele frequency
            // Filter for high-impact consequences in annotation
            '--include "INFO/ANN~\\"HIGH\\""'         // High impact variants only
        ].join(' && ')
        
        ext.prefix = { "${meta.id}.high_impact" }
        
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling_filtered/freebayes/${meta.id}/" },
            pattern: "*.vcf.gz"
        ]
    }
    
    // Variant summary extraction
    withName: 'VCF_FILTER_FREEBAYES:BCFTOOLS_QUERY' {
        ext.args = [
            '-f', 
            "'%CHROM\\t%POS\\t%REF\\t%ALT\\t%QUAL\\t%INFO/DP\\t%INFO/AF\\t%INFO/ANN\\n'"
        ].join(' ')
        
        ext.prefix = { "${meta.id}.variant_summary" }
        ext.suffix = "txt"
        
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling_filtered/freebayes/${meta.id}/" },
            pattern: "*.txt"
        ]
    }
    
    // Tabix indexing for filtered VCFs
    withName: 'VCF_FILTER_FREEBAYES:TABIX_TABIX' {
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling_filtered/freebayes/${meta.id}/" },
            pattern: "*.tbi"
        ]
    }
    
    withName: 'VCF_FILTER_FREEBAYES:TABIX_HIGH_IMPACT' {
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling_filtered/freebayes/${meta.id}/" },
            pattern: "*.tbi"
        ]
    }
}