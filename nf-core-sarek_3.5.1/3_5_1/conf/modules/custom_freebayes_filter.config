/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for FreeBayes filtering modules
    NOTE: FreeBayes runs in germline-only mode per CLAUDE.md
    Somatic filtering has been removed (see: ✅ FreeBayes Somatic Mode Disabled)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // Germline quality filtering for FreeBayes variants
    withName: '.*VCF_FILTER_FREEBAYES:BCFTOOLS_FILTER_NORMAL' {
        ext.when = { meta.variantcaller == 'freebayes' }
        // Quality filter parameters optimized for yeast ALE experiments
        // Designed to remove obvious false positives while retaining potential true variants
        //
        // NOTE: Multi-allelic sites are preserved (no bcftools norm splitting)
        // All comma-separated INFO fields (AO, SAF, SAR) work correctly:
        //   - bcftools checks if ANY allele passes the threshold (not ALL alleles)
        //   - Example: AO=9,1 with AO>=2 → PASS (first allele meets threshold)
        //   - Tested on real data: AO>=2 correctly filters 26 low-coverage multi-allelic sites
        ext.args = [
            '--include',
            '"QUAL>=15',                       // Minimum variant quality score (relaxed from 20)
            '& INFO/DP>=8',                    // Minimum total sequencing depth (relaxed from 10-11)
            '& INFO/DP<=500',                  // Maximum depth to avoid repeat regions and CNVs
            '& INFO/SAF>0 & INFO/SAR>0',      // Strand bias: require forward+reverse reads (ANY allele)
            '& INFO/AO>=2',                    // Minimum alternate observations (ANY allele, relaxed from 3)
            '& INFO/MQM>=20 & INFO/MQMR>=20"', // Good mapping quality for both alt and ref
            '--output-type z'                  // Output compressed VCF (index created manually by process)
        ].join(' ')

        ext.prefix = { "${meta.id}" }

        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling_filtered/freebayes/${meta.id}/" },
            pattern: "*.vcf.gz*"
        ]
    }
}