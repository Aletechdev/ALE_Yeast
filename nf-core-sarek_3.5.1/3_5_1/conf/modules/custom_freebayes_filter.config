/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for FreeBayes filtering modules
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // Basic quality filtering for FreeBayes variants - try broader match
    withName: '.*VCF_FILTER_FREEBAYES:BCFTOOLS_FILTER' {
        ext.when = { meta.variantcaller == 'freebayes' && meta.normal_id == null && meta.tumor_id == null }
        // Less stringent bcftools filter parameters for FreeBayes VCF filtering
        // Designed to remove obvious false positives while retaining potential true variants
        ext.args = [
            '--include',
            '"QUAL>=15',                    // Minimum variant quality score (relaxed from 20)
            '& INFO/DP>=8',                 // Minimum total sequencing depth (relaxed from 10-11)
            '& INFO/DP<=500',               // Maximum depth to avoid repeat regions and copy number variants
            '& INFO/AF>=0.03',              // Minimum allele frequency - excludes most sequencing errors (relaxed from 0.05)
            '& INFO/AO>=2',                 // Minimum alternate allele observations (relaxed from 3)
            '& INFO/MQM>=15"',              // Minimum mean mapping quality for alternate alleles (relaxed from 20)
            '--output-type z',              // Output compressed VCF
            '--write-index=tbi'             // Create tabix index automatically
        ].join(' ')
        
        ext.prefix = { "${meta.id}" }
        
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling_filtered/freebayes/${meta.id}/" },
            pattern: "*.vcf.gz*"
        ]
    }
    
    // Tumor-normal variant filtering - must be more specific than generic BCFTOOLS_FILTER
    withName: '.*VCF_FILTER_FREEBAYES:BCFTOOLS_FILTER_SOMATIC' {
        ext.prefix = { "${meta.id}" }
        // Combined somatic variant filtering for FreeBayes tumor-normal pairs
        // Includes both quality filters and somatic-specific genotype requirements
        ext.args = [
            '--include',
            '"QUAL>=20',                                    // Higher quality threshold for somatic variants
            '& INFO/DP>=15',                                // Higher total depth requirement
            '& INFO/DP<=300',                               // Avoid extremely high depth regions
            '& INFO/AF>=0.05',              // Allele frequency range for somatic variants
            '& INFO/AO>=3',                                 // At least 3 alternate observations
            '& INFO/SAF>0 & INFO/SAR>0',                   // Require reads on both strands
            '& INFO/MQM>=20 & INFO/MQMR>=20"'              // Good mapping quality for both alt and ref
        ].join(' ')
        
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling_filtered/freebayes/${meta.id}/" },
            pattern: "*.vcf.gz*",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    // Variant summary extraction
    withName: 'VCF_FILTER_FREEBAYES:BCFTOOLS_QUERY' {
        ext.args = [
            '-f', 
            "'%CHROM\\t%POS\\t%REF\\t%ALT\\t%QUAL\\t%INFO/DP\\t%INFO/AF\\t%INFO/ANN\\n'"
        ].join(' ')
        
        ext.prefix = { "${meta.id}.variant_summary" }
        ext.suffix = "txt"
        
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling_filtered/freebayes/${meta.id}/" },
            pattern: "*.txt"
        ]
    }
    
    // Tabix indexing for filtered VCFs
    withName: 'VCF_FILTER_FREEBAYES:TABIX_TABIX' {
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling_filtered/freebayes/${meta.id}/" },
            pattern: "*.tbi"
        ]
    }
    
    withName: 'VCF_FILTER_FREEBAYES:TABIX_HIGH_IMPACT' {
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling_filtered/freebayes/${meta.id}/" },
            pattern: "*.tbi"
        ]
    }
}