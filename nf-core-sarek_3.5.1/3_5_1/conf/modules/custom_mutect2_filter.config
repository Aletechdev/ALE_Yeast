/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for Mutect2 filtering modules
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    
    // Tumor-normal variant filtering - must be more specific than generic BCFTOOLS_FILTER
    withName: '.*VCF_FILTER_MUTECT2:BCFTOOLS_FILTER_SOMATIC' {
        ext.prefix = { "${meta.id}" }
        ext.args = [
            '--include',
            '"INFO/DP>=15',                                 // Minimum total sequencing depth
            '& INFO/DP<=300',                               // Maximum depth to avoid repeat regions  
            '& INFO/TLOD > 10',                               // Higher tumor LOD support (increased from 3)
            '& (INFO/MMQ[0]>=20 & INFO/MMQ[1]>=20)',        // Good mapping quality for ref and alt
            '& INFO/MBQ[1]>=20"'                            // Minimum base quality for alternate allele
        ].join(' ')
        
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling_filtered/mutect2/${meta.id}/" },
            pattern: "*.vcf.gz*",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    

    

}